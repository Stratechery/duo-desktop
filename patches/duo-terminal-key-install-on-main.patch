@@ -0,0 +1,58 @@
+import Foundation
+import Testing
+@testable import GlassActCore
+import GlassActWire
+
+/// Duo Desktop build (review fixes, review finding 2). Control bytes are authorized by the
+/// transport that delivered them. The Host's `onControl` hops to the engine queue and asks
+/// `HostControlDelivery` for the engine; this replays the reviewer's schedule against it.
+@Suite struct HostControlDeliveryTests {
+    static func running(on t: CaptureTransport) -> HostEngine {
+        let host = HostEngine(width: 64, height: 64, transport: t)
+        host.start(nowUS: 0)
+        host.handleControl(Data(ControlMessage.helloOK(ver: WireVersion.current, caps: 0, geoMode: 0,
+                                                       geoWidth: 0, geoHeight: 0, geoScale: 0).encoded()), nowUS: 1_000)
+        return host
+    }
+
+    /// The focused check: A's control callback is entered, delayed before its engine-queue
+    /// hop; B is adopted and handshakes; A's key request is released. Nothing is handled as B.
+    @Test func anEarlierViewersDelayedBytesNeverReachTheNewViewersEngine() {
+        let tA = CaptureTransport(), tB = CaptureTransport()
+        let keyRequest = Data(ControlMessage.terminalKeyInstall(requestID: 7, keyLine: "ssh-ed25519 AAAA x").encoded())
+        let unlock = Data(ControlMessage.unlockType(password: Array("pw".utf8)).encoded())
+        // A is the session; its callback captured its bytes (and its transport) and is delayed.
+        var engine: HostEngine? = Self.running(on: tA)
+        var sessionTransport: AnyObject? = tA
+        let delayedFromA = [keyRequest, unlock]
+        // B adopted (engine and session transport replaced together) and past its handshake.
+        let engineB = Self.running(on: tB)
+        var heardByB: [String] = []
+        engineB.onTerminalKeyInstall = { id, _ in heardByB.append("key \(id)") }
+        engineB.onUnlockType = { _ in heardByB.append("unlock") }
+        engine = engineB
+        sessionTransport = tB
+        // A's bytes reach the engine queue now.
+        for bytes in delayedFromA {
+            HostControlDelivery.engine(current: engine, sessionTransport: sessionTransport, deliveredBy: tA)?
+                .handleControl(bytes, nowUS: 2_000)
+        }
+        #expect(heardByB.isEmpty)
+        #expect(HostControlDelivery.engine(current: engine, sessionTransport: sessionTransport, deliveredBy: tA) == nil)
+        // B's own request goes to B.
+        HostControlDelivery.engine(current: engine, sessionTransport: sessionTransport, deliveredBy: tB)?
+            .handleControl(keyRequest, nowUS: 3_000)
+        #expect(heardByB == ["key 7"])
+    }
+
+    @Test func anEngineNotMadeOnTheSessionTransportReadsNothing() {
+        let tA = CaptureTransport(), tB = CaptureTransport()
+        let engineA = Self.running(on: tA)
+        // Between adopt's two writes, or any mismatch: no engine.
+        #expect(HostControlDelivery.engine(current: engineA, sessionTransport: tB, deliveredBy: tB) == nil)
+        #expect(HostControlDelivery.engine(current: engineA, sessionTransport: tA, deliveredBy: tA) === engineA)
+        #expect(HostControlDelivery.engine(current: engineA, sessionTransport: tA, deliveredBy: nil) == nil)
+        #expect(HostControlDelivery.engine(current: nil, sessionTransport: tA, deliveredBy: tA) == nil)
+        #expect(HostControlDelivery.engine(current: engineA, sessionTransport: nil, deliveredBy: tA) == nil)
+    }
+}
