diff --git a/Sources/GlassActWire/TerminalKey.swift b/Sources/GlassActWire/TerminalKey.swift
new file mode 100644
index 0000000..58ad7b0
--- /dev/null
+++ b/Sources/GlassActWire/TerminalKey.swift
@@ -0,0 +1,48 @@
+// Duo Desktop build (terminal key) — TERMINAL_KEY_INSTALL (0x70, viewer → host)
+// and TERMINAL_KEY_RESULT (0x71, host → viewer). Additive: an older Host skips
+// 0x70 by its length and never answers, so the viewer falls back after a wait.
+
+/// What the Host answers to one TERMINAL_KEY_INSTALL.
+public struct WireTerminalKeyResult: Equatable, Sendable {
+    public enum Status: UInt8, Sendable {
+        /// The line was added to the account's `authorized_keys`.
+        case installed = 0
+        /// The same key (type and key text) was already there; nothing written.
+        case alreadyThere = 1
+        /// Refused; `reason` says why. Nothing written.
+        case refused = 2
+        /// Duo Desktop build (review fixes 2): not an answer yet. The Host is asking its user
+        /// whether this device may add its SSH key (an approval from before the Host recorded
+        /// that); the real answer follows with the same request ID.
+        case askingOnMac = 3
+    }
+    public var requestID: UInt32
+    public var status: Status
+    /// The SSH port is listening: something accepts on this Mac's port 22 (a hint, not proof of the Remote Login setting).
+    public var remoteLoginOn: Bool
+    /// A `tmux` binary is in one of the usual places.
+    public var tmuxPresent: Bool
+    /// The short name of the account running the Host (the SSH user).
+    public var userName: String
+    /// Plain words, empty unless refused.
+    public var reason: String
+
+    public init(requestID: UInt32, status: Status, remoteLoginOn: Bool, tmuxPresent: Bool,
+                userName: String, reason: String = "") {
+        self.requestID = requestID
+        self.status = status
+        self.remoteLoginOn = remoteLoginOn
+        self.tmuxPresent = tmuxPresent
+        self.userName = userName
+        self.reason = reason
+    }
+}
+
+extension ControlMessage {
+    /// Upper bound on the key line in TERMINAL_KEY_INSTALL (an RSA-8192 line
+    /// is about 1.4 KB; anything bigger is refused at parse).
+    public static let maxTerminalKeyLineBytes = 4096
+    /// Upper bounds on the strings in TERMINAL_KEY_RESULT.
+    public static let maxTerminalKeyUserBytes = 255
+    public static let maxTerminalKeyReasonBytes = 255
+}
