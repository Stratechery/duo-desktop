@@ -0,0 +1,51 @@
+import XCTest
+import Foundation
+import GlassActCore
+@testable import GlassActSession
+import GlassActTransport
+import GlassActWire
+
+/// Duo Desktop build (terminal key), live: a running host on this Mac
+/// (`GLASSACT_TERMKEY_PORT`) is asked over a real session to add the key line
+/// in `GLASSACT_TERMKEY_LINE`. Prints what it answered. With
+/// `GLASSACT_TERMKEY_EXPECT_SILENT=1` the host is expected not to answer (an
+/// older Host). Skipped unless the port is set.
+final class RealHostTerminalKeyProofTests: XCTestCase {
+    @MainActor
+    func spin(_ seconds: Double, until done: () -> Bool) {
+        let end = Date().addingTimeInterval(seconds)
+        while !done(), Date() < end { RunLoop.main.run(until: Date().addingTimeInterval(0.02)) }
+    }
+
+    @MainActor
+    func testInstallOverARealSession() throws {
+        let env = ProcessInfo.processInfo.environment
+        guard let port = env["GLASSACT_TERMKEY_PORT"].flatMap(UInt16.init),
+              let line = env["GLASSACT_TERMKEY_LINE"] else { throw XCTSkip("no host (GLASSACT_TERMKEY_PORT)") }
+        let dir = URL(fileURLWithPath: NSTemporaryDirectory()).appendingPathComponent("termkey-proof")
+        try FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)
+        let id = try QUICIdentity.loadOrCreate(directory: dir, name: "proof-viewer-identity", commonName: "termkey-proof")
+        let session = ViewerSession(host: "127.0.0.1", port: port, fingerprint: "", identity: id,
+                                    options: .init(cursorMetadata: true, video: false, deviceName: "termkey-proof"))
+        var results: [WireTerminalKeyResult] = []
+        session.onTerminalKeyResult = { results.append($0) }
+        session.setRequestedGeometry(mode: 2, widthPoints: 1280, heightPoints: 800, scale: 1)
+        session.start()
+        defer { session.stop() }
+        spin(15) { session.configuredGrid() != nil }
+        XCTAssertNotNil(session.configuredGrid(), "session running")
+        final class Box: @unchecked Sendable { var sent: Bool? }
+        let box = Box()
+        session.installTerminalKey(requestID: 42, keyLine: line) { ok in box.sent = ok } // main thread
+        spin(5) { !results.isEmpty }
+        XCTAssertEqual(box.sent, true)
+        if env["GLASSACT_TERMKEY_EXPECT_SILENT"] == "1" {
+            XCTAssertTrue(results.isEmpty, "an older host does not answer")
+            print("proof: no answer in 5 s (older host)")
+            return
+        }
+        let r = try XCTUnwrap(results.first, "the host answered")
+        XCTAssertEqual(r.requestID, 42)
+        print("proof: answer status=\(r.status) user=\(r.userName) remoteLogin=\(r.remoteLoginOn) tmux=\(r.tmuxPresent) reason=\"\(r.reason)\"")
+    }
+}
diff --git a/Tests/TransportTests/SSHKeyPermissionTests.swift b/Tests/TransportTests/SSHKeyPermissionTests.swift
new file mode 100644
index 0000000..7ce9016
--- /dev/null
+++ b/Tests/TransportTests/SSHKeyPermissionTests.swift
@@ -0,0 +1,117 @@
+import CryptoKit
+import Foundation
+import Security
+import Testing
+@testable import GlassActTransport
+
+/// Duo Desktop build (review fixes, review finding 1). Approval is keyed by the public key, but
+/// the agent/viewer name is the certificate's, which the key's holder can reissue at will. Who
+/// may add an SSH key is the Host's own record of what it approved the key AS.
+@Suite struct SSHKeyPermissionTests {
+    static func list() -> (AuthorizedViewers, URL) {
+        let url = FileManager.default.temporaryDirectory
+            .appendingPathComponent("duo-sshperm-\(UInt64.random(in: 0...UInt64.max))")
+        return (AuthorizedViewers(url: url), url)
+    }
+
+    /// The focused check: one P-256 key, an agent certificate then a viewer certificate.
+    @Test func anAgentApprovalStaysRefusedWhenTheSameKeyPresentsAViewerCertificate() throws {
+        let key = P256.Signing.PrivateKey()
+        let agentDER = try SelfSignedIdentity.makeCertificate(key: key, commonName: "glassact-agent", validFor: 30, now: Date())
+        let viewerDER = try SelfSignedIdentity.makeCertificate(key: key, commonName: "duo-viewer", validFor: 30, now: Date())
+        let agentCert = try #require(SecCertificateCreateWithData(nil, Data(agentDER) as CFData))
+        let viewerCert = try #require(SecCertificateCreateWithData(nil, Data(viewerDER) as CFData))
+        let fp = QUICIdentity.fingerprint(of: agentCert)
+        #expect(QUICIdentity.fingerprint(of: viewerCert) == fp) // same approval key
+        let asAgent = QUICTransport.PeerCertificate(fingerprint: fp, commonName: "glassact-agent")
+        let asViewer = QUICTransport.PeerCertificate(fingerprint: fp, commonName: "duo-viewer")
+        #expect(asAgent.isAgent && !asViewer.isAgent)
+
+        let (viewers, url) = Self.list()
+        defer { try? FileManager.default.removeItem(at: url) }
+        try viewers.add(fp, viewOnly: false, kind: .agent) // the Host's user approved an agent, with control
+        #expect(viewers.sshKeyRefusal(for: asAgent) == "an agent cannot add SSH keys")
+        // The same key reconnects with the viewer certificate; the Host notes what it presented.
+        viewers.noteSeen(fp, kind: .viewer, address: "")
+        #expect(viewers.all.first?.kind == .viewer)           // presented name followed
+        #expect(viewers.approvedAs(fp) == .agent)              // the approval did not
+        #expect(!viewers.mayAddSSHKeys(fp))
+        #expect(viewers.sshKeyRefusal(for: asViewer)
+                == "this key was approved as an agent on this Mac; an agent cannot add SSH keys")
+        // Saved and reloaded (a Host restart): still refused.
+        let reloaded = AuthorizedViewers(url: url)
+        #expect(reloaded.sshKeyRefusal(for: asViewer) != nil)
+        #expect(reloaded.approvedAs(fp) == .agent)
+    }
+
+    @Test func anApprovedControllingViewerMayAddAKeyOthersMayNot() throws {
+        let (viewers, url) = Self.list()
+        defer { try? FileManager.default.removeItem(at: url) }
+        let person = String(repeating: "a", count: 64), watcher = String(repeating: "b", count: 64)
+        let stranger = String(repeating: "c", count: 64)
+        try viewers.add(person, viewOnly: false, kind: .viewer)
+        try viewers.add(watcher, viewOnly: true, kind: .viewer)
+        func peer(_ fp: String) -> QUICTransport.PeerCertificate { .init(fingerprint: fp, commonName: "duo-viewer") }
+        #expect(viewers.sshKeyRefusal(for: peer(person)) == nil)
+        #expect(viewers.sshKeyRefusal(for: peer(watcher)) == "this viewer is set to view only on this Mac")
+        #expect(viewers.sshKeyRefusal(for: peer(stranger)) == "this viewer is not approved on this Mac")
+        #expect(viewers.sshKeyRefusal(for: nil) == "this viewer is not approved on this Mac")
+        // A viewer approval presenting an agent certificate is refused too (stricter only).
+        #expect(viewers.sshKeyRefusal(for: .init(fingerprint: person, commonName: "glassact-agent")) != nil)
+    }
+
+    /// Review fixes 2 (the reviewer's focused check): a list saved before `as=` existed. Its `kind` is
+    /// only what the key last presented, so it grants nothing. Screen sharing stays exactly as it
+    /// was; SSH-key permission waits for the Host's user to answer the one-time question.
+    @Test func anOlderListGrantsNoSSHKeysUntilTheHostsUserAnswers() throws {
+        let url = FileManager.default.temporaryDirectory
+            .appendingPathComponent("duo-sshperm-legacy-\(UInt64.random(in: 0...UInt64.max))")
+        defer { try? FileManager.default.removeItem(at: url) }
+        let person = String(repeating: "d", count: 64), agent = String(repeating: "e", count: 64)
+        let other = String(repeating: "f", count: 64), watcher = String(repeating: "1", count: 64)
+        // The reviewer's line: an agent approved by the old Host, last seen with a viewer certificate.
+        try "\(person) kind=viewer approved=1 seen=2\n\(agent) kind=agent approved=1\n\(other)\n\(watcher) view kind=viewer\n"
+            .write(to: url, atomically: true, encoding: .utf8)
+        func viewer(_ fp: String) -> QUICTransport.PeerCertificate { .init(fingerprint: fp, commonName: "duo-viewer") }
+        let viewers = AuthorizedViewers(url: url)
+        // Screen sharing unchanged.
+        for fp in [person, agent, other, watcher] { #expect(viewers.contains(fp)) }
+        #expect(!viewers.isViewOnly(person) && viewers.isViewOnly(watcher))
+        // No SSH-key permission from the old `kind`.
+        #expect(viewers.approvedAs(person) == .unknown)
+        #expect(!viewers.mayAddSSHKeys(person))
+        #expect(viewers.sshKeyRefusal(for: viewer(person)) != nil)
+        #expect(!viewers.mayAddSSHKeys(other))
+        // The Host asks its user, only for a person's viewer with control.
+        #expect(viewers.needsSSHKeyQuestion(for: viewer(person)))
+        #expect(viewers.needsSSHKeyQuestion(for: viewer(other)))
+        #expect(!viewers.needsSSHKeyQuestion(for: viewer(watcher)))           // view only: refused, no question
+        #expect(!viewers.needsSSHKeyQuestion(for: viewer(agent)))             // recorded agent stays an agent
+        let personAsAgent = QUICTransport.PeerCertificate(fingerprint: person, commonName: "glassact-agent")
+        #expect(viewers.needsSSHKeyQuestion(for: personAsAgent) == false)
+        #expect(viewers.sshKeyRefusal(for: viewer(agent))
+                == "this key was approved as an agent on this Mac; an agent cannot add SSH keys")
+        // Seeing it again changes nothing.
+        viewers.noteSeen(person, kind: .viewer, address: "")
+        #expect(!viewers.mayAddSSHKeys(person) && viewers.needsSSHKeyQuestion(for: viewer(person)))
+        #expect(!(try String(contentsOf: url, encoding: .utf8)).contains("\(person) kind=viewer as="))
+        // Allow: recorded as the Host's own permission, kept across a restart.
+        try viewers.decideSSHKeys(person, allow: true)
+        #expect(viewers.sshKeyRefusal(for: viewer(person)) == nil)
+        #expect(!viewers.needsSSHKeyQuestion(for: viewer(person)))
+        // Don't Allow: recorded, never asked again, screen sharing kept.
+        try viewers.decideSSHKeys(other, allow: false)
+        #expect(viewers.sshKeyRefusal(for: viewer(other)) == "this Mac's user did not allow this device to add SSH keys")
+        #expect(!viewers.needsSSHKeyQuestion(for: viewer(other)))
+        let text = try String(contentsOf: url, encoding: .utf8)
+        #expect(text.contains("\(person) kind=viewer as=viewer"))
+        #expect(text.contains("\(other) keys=no"))
+        let reloaded = AuthorizedViewers(url: url)
+        #expect(reloaded.mayAddSSHKeys(person))
+        #expect(!reloaded.mayAddSSHKeys(other) && !reloaded.needsSSHKeyQuestion(for: viewer(other)))
+        #expect(reloaded.contains(other) && !reloaded.isViewOnly(other))
+        // A fresh approval by the Host's user (dialog) still works as build 45 made it.
+        try reloaded.add(other, viewOnly: false, kind: .viewer)
+        #expect(reloaded.mayAddSSHKeys(other))
+    }
+}
