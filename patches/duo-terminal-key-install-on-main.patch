@@ -0,0 +1,152 @@
+import Foundation
+import Testing
+import GlassActCore
+import GlassActWire
+
+/// Duo Desktop build (terminal key). Made-up keys (their private halves were
+/// thrown away); every file write goes to a made-up home folder.
+@Suite struct TerminalKeyInstallTests {
+    static let ed = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJtFYnnnurmhBwS76STVJmtpyWFw0g3TqaWtQvkJ17YB duo-desktop"
+    static let edFingerprint = "SHA256:0w0OY4RbCipRDHRI9tzIkmqitRcwce/2YVGfKbQ+ACU"
+    static let ecdsa = "ecdsa-sha2-nistp256 AAAAE2VjZHNhLXNoYTItbmlzdHAyNTYAAAAIbmlzdHAyNTYAAABBBLcoWin/AYwN3XTYxwOihv81y5nXJvtoQk1miV5XUIVQ5GfIWwjrTD97buqT8BHeMmQCap6c94jNiDEm6DRRPIM= duo-desktop"
+
+    private func madeUpHome() throws -> URL {
+        let dir = FileManager.default.temporaryDirectory.appendingPathComponent("termkey-\(UUID().uuidString)")
+        try FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)
+        return dir
+    }
+
+    private func mode(_ url: URL) throws -> Int {
+        try (FileManager.default.attributesOfItem(atPath: url.path)[.posixPermissions] as? NSNumber)?.intValue ?? -1
+    }
+
+    @Test func goodLinesPass() throws {
+        for line in [Self.ed, Self.ecdsa, String(Self.ed.dropLast(" duo-desktop".count))] {
+            guard case let .success(k) = TerminalKeyLine.check(line) else {
+                Issue.record("refused \(line)"); continue
+            }
+            #expect(k.line == line)
+        }
+        guard case let .success(k) = TerminalKeyLine.check(Self.ed) else { return }
+        #expect(k.fingerprint == Self.edFingerprint) // as ssh-keygen -l prints it
+    }
+
+    static let ecdsaAsEd: String = ecdsa.replacingOccurrences(of: "ecdsa-sha2-nistp256 ", with: "ssh-ed25519 ")
+    static let badLines: [(String, String)] = {
+        var a: [(String, String)] = []
+        a.append(("", "empty"))
+        a.append((String(repeating: "a", count: 4097), "too long"))
+        a.append((Self.ed + "\nssh-ed25519 AAAA x", "line break"))
+        a.append((Self.ed + "\r", "line break"))
+        a.append(("command=\"/bin/sh\" " + Self.ed, "quotes"))
+        a.append(("no-pty " + Self.ed, "type is not known"))
+        a.append(("ssh-dss AAAAB3NzaC1kc3MAAAA x", "type is not known"))
+        a.append((Self.ed.replacingOccurrences(of: " duo", with: "\tduo"), "not allowed"))
+        a.append((" " + Self.ed, "extra spaces"))
+        a.append((Self.ed + " ", "extra spaces"))
+        a.append((Self.ed.replacingOccurrences(of: " duo-desktop", with: "  duo-desktop"), "extra spaces"))
+        a.append(("ssh-ed25519 AAAA$C3Nz x", "base64"))
+        a.append(("ssh-ed25519 AAAAC3NzaC1lZDI1NTE5 x", "incomplete"))
+        // An ecdsa body labelled ed25519.
+        a.append((ecdsaAsEd, "match"))
+        a.append((Self.ed + " more", "not one key"))
+        a.append((Self.ed.replacingOccurrences(of: "duo-desktop", with: "duo;rm"), "not allowed"))
+        a.append((Self.ed.replacingOccurrences(of: "duo-desktop", with: "duo\\x"), "backslash"))
+        a.append((Self.ed.replacingOccurrences(of: "duo-desktop", with: "dűo"), "not allowed"))
+        return a
+    }()
+
+    @Test(arguments: badLines)
+    func badLinesAreRefused(_ line: String, _ reasonPart: String) {
+        guard case let .failure(r) = TerminalKeyLine.check(line) else {
+            Issue.record("accepted \(line.debugDescription)"); return
+        }
+        #expect(r.reason.contains(reasonPart), "\(r.reason)")
+    }
+
+    @Test func createsFolderAndFileWithTightModes() throws {
+        let home = try madeUpHome()
+        defer { try? FileManager.default.removeItem(at: home) }
+        let out = TerminalKeyInstaller(home: home).install(Self.ed)
+        #expect(out == .installed(fingerprint: Self.edFingerprint))
+        let ssh = home.appendingPathComponent(".ssh"), file = ssh.appendingPathComponent("authorized_keys")
+        #expect(try mode(ssh) == 0o700)
+        #expect(try mode(file) == 0o600)
+        #expect(try String(contentsOf: file, encoding: .utf8) == Self.ed + "\n")
+    }
+
+    @Test func appendsOnceAndKeepsEverythingElse() throws {
+        let home = try madeUpHome()
+        defer { try? FileManager.default.removeItem(at: home) }
+        let ssh = home.appendingPathComponent(".ssh"), file = ssh.appendingPathComponent("authorized_keys")
+        try FileManager.default.createDirectory(at: ssh, withIntermediateDirectories: true,
+                                                attributes: [.posixPermissions: 0o755])
+        // Another key with options, a comment line, CRLF, and no final line end.
+        let before = "# mine\r\nfrom=\"10.0.0.1\" " + Self.ecdsa.replacingOccurrences(of: "duo-desktop", with: "laptop")
+        try Data(before.utf8).write(to: file)
+        try FileManager.default.setAttributes([.posixPermissions: 0o644], ofItemAtPath: file.path)
+        let installer = TerminalKeyInstaller(home: home)
+        #expect(installer.install(Self.ed) == .installed(fingerprint: Self.edFingerprint))
+        // Same key, another comment: already there; and the ecdsa key with options in front: already there.
+        #expect(installer.install(Self.ed.replacingOccurrences(of: "duo-desktop", with: "other")) ==
+                .alreadyThere(fingerprint: Self.edFingerprint))
+        guard case .alreadyThere = installer.install(Self.ecdsa) else { Issue.record("ecdsa duplicated"); return }
+        let after = try Data(contentsOf: file)
+        #expect(after == Data((before + "\n" + Self.ed + "\n").utf8)) // old bytes untouched, one new line
+        #expect(try mode(ssh) == 0o755) // an existing folder and file keep their modes
+        #expect(try mode(file) == 0o644)
+    }
+
+    @Test func refusesALinkOrAFileInPlaceOfTheFolder() throws {
+        let home = try madeUpHome()
+        defer { try? FileManager.default.removeItem(at: home) }
+        try Data("x".utf8).write(to: home.appendingPathComponent(".ssh"))
+        guard case .refused = TerminalKeyInstaller(home: home).install(Self.ed) else { Issue.record("wrote"); return }
+
+        let home2 = try madeUpHome()
+        defer { try? FileManager.default.removeItem(at: home2) }
+        let ssh = home2.appendingPathComponent(".ssh")
+        try FileManager.default.createDirectory(at: ssh, withIntermediateDirectories: true)
+        let target = home2.appendingPathComponent("elsewhere")
+        try Data().write(to: target)
+        try FileManager.default.createSymbolicLink(at: ssh.appendingPathComponent("authorized_keys"),
+                                                   withDestinationURL: target)
+        guard case .refused = TerminalKeyInstaller(home: home2).install(Self.ed) else { Issue.record("followed link"); return }
+        #expect(try Data(contentsOf: target).isEmpty)
+    }
+
+    @Test func refusedLineWritesNothing() throws {
+        let home = try madeUpHome()
+        defer { try? FileManager.default.removeItem(at: home) }
+        guard case .refused = TerminalKeyInstaller(home: home).install("no-pty " + Self.ed) else {
+            Issue.record("accepted"); return
+        }
+        #expect(!FileManager.default.fileExists(atPath: home.appendingPathComponent(".ssh").path))
+    }
+
+    @Test func logLineNeverCarriesTheKey() {
+        let line = TerminalKeyMacState.logLine(.installed(fingerprint: Self.edFingerprint), viewer: "Phone")
+        #expect(line.contains(Self.edFingerprint) && line.contains("Phone"))
+        #expect(!line.contains("AAAAC3Nza"))
+    }
+
+    @Test func wireRoundTripAndOlderPeersSkipIt() throws {
+        let install = ControlMessage.terminalKeyInstall(requestID: 7, keyLine: Self.ed)
+        let result = ControlMessage.terminalKeyResult(WireTerminalKeyResult(
+            requestID: 7, status: .refused, remoteLoginOn: true, tmuxPresent: false, userName: "someone",
+            reason: "the key line is empty"))
+        var d = ControlDeframer()
+        d.append(install.encoded())
+        d.append(result.encoded())
+        #expect(d.next() == .message(install))
+        #expect(d.next() == .message(result))
+        // An older peer: the same bytes under a type it does not know are skipped by length.
+        var stale = install.encoded()
+        stale[0] = 0x7E
+        var old = ControlDeframer()
+        old.append(stale)
+        old.append(ControlMessage.ping(nonce: 1, tUS: 2).encoded())
+        #expect(old.next() == .skippedUnknown(type: 0x7E))
+        #expect(old.next() == .message(.ping(nonce: 1, tUS: 2)))
+    }
+}
