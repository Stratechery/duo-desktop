diff --git a/Sources/GlassActCore/TerminalKeyInstall.swift b/Sources/GlassActCore/TerminalKeyInstall.swift
new file mode 100644
index 0000000..0e28560
--- /dev/null
+++ b/Sources/GlassActCore/TerminalKeyInstall.swift
@@ -0,0 +1,255 @@
+// Duo Desktop build (terminal key). The Host side of TERMINAL_KEY_INSTALL:
+// check one OpenSSH public key line strictly and append it to
+// `<home>/.ssh/authorized_keys` of the account running the Host. It never
+// removes or rewrites a line, never touches another account and never runs
+// anything. Pure file work on a given home folder, so tests drive it against
+// a made-up one.
+
+public import Foundation
+public import GlassActWire
+import CryptoKit
+#if os(macOS)
+import Darwin
+#endif
+
+public enum TerminalKeyLine {
+    /// Key types accepted (the first field of the line).
+    public static let knownTypes: Set<String> = [
+        "ssh-ed25519", "ssh-rsa",
+        "ecdsa-sha2-nistp256", "ecdsa-sha2-nistp384", "ecdsa-sha2-nistp521",
+        "sk-ssh-ed25519@openssh.com", "sk-ecdsa-sha2-nistp256@openssh.com",
+    ]
+
+    /// A checked line: its type, key text (base64) and the decoded key.
+    public struct Parsed: Equatable, Sendable {
+        public var type: String
+        public var base64: String
+        public var blob: Data
+        /// The normalised line written to the file: `type base64[ comment]`.
+        public var line: String
+        /// `SHA256:…` as `ssh-keygen -l` prints it.
+        public var fingerprint: String {
+            "SHA256:" + Data(SHA256.hash(data: blob)).base64EncodedString().replacingOccurrences(of: "=", with: "")
+        }
+    }
+
+    /// Checks one line. Returns the parsed key, or a plain reason it was refused.
+    /// Accepted: `type base64` or `type base64 comment`, single spaces, a known
+    /// type, a base64 body that decodes and names the same type inside, a
+    /// comment of plain characters, at most `ControlMessage.maxTerminalKeyLineBytes`.
+    /// Refused: anything else, including options, quotes, tabs, line ends and
+    /// leading or trailing spaces.
+    public static func check(_ line: String) -> Result<Parsed, Refusal> {
+        let bytes = Array(line.utf8)
+        guard !bytes.isEmpty else { return .failure(Refusal("the key line is empty")) }
+        guard bytes.count <= ControlMessage.maxTerminalKeyLineBytes else {
+            return .failure(Refusal("the key line is too long"))
+        }
+        // Printable ASCII and single spaces only: no line ends, tabs, NULs,
+        // quotes or backslashes (nothing a shell or sshd option could use).
+        for b in bytes {
+            if b == 0x0A || b == 0x0D { return .failure(Refusal("the key line has a line break")) }
+            if b == 0x22 || b == 0x27 || b == 0x60 || b == 0x5C {
+                return .failure(Refusal("the key line has quotes or a backslash"))
+            }
+            if b < 0x20 || b > 0x7E { return .failure(Refusal("the key line has characters that are not allowed")) }
+        }
+        let fields = line.split(separator: " ", omittingEmptySubsequences: false).map(String.init)
+        guard !fields.contains(where: \.isEmpty) else {
+            return .failure(Refusal("the key line has extra spaces"))
+        }
+        guard knownTypes.contains(fields[0]) else {
+            return .failure(Refusal("the key type is not known (options are not accepted)"))
+        }
+        guard fields.count == 2 || fields.count == 3 else {
+            return .failure(Refusal("the key line is not one key (type, key, optional name)"))
+        }
+        let type = fields[0], body = fields[1]
+        guard body.utf8.allSatisfy({ isBase64Byte($0) }), body.utf8.count % 4 == 0,
+              let blob = Data(base64Encoded: body), blob.count >= 4 + type.utf8.count else {
+            return .failure(Refusal("the key is not valid base64"))
+        }
+        // The blob starts with the same type: uint32 length + name.
+        let n = Int(blob[blob.startIndex]) << 24 | Int(blob[blob.startIndex + 1]) << 16
+            | Int(blob[blob.startIndex + 2]) << 8 | Int(blob[blob.startIndex + 3])
+        guard n == type.utf8.count,
+              blob.subdata(in: blob.startIndex + 4 ..< blob.startIndex + 4 + n) == Data(type.utf8) else {
+            return .failure(Refusal("the key does not match its type"))
+        }
+        // Then at least one more field: a length that fits, and some key bytes.
+        let rest = blob.startIndex + 4 + n
+        guard blob.endIndex - rest >= 5 else { return .failure(Refusal("the key is incomplete")) }
+        let m = Int(blob[rest]) << 24 | Int(blob[rest + 1]) << 16 | Int(blob[rest + 2]) << 8 | Int(blob[rest + 3])
+        guard m > 0, m <= blob.endIndex - rest - 4 else { return .failure(Refusal("the key is incomplete")) }
+        if fields.count == 3 {
+            guard fields[2].utf8.allSatisfy({ isCommentByte($0) }) else {
+                return .failure(Refusal("the key name has characters that are not allowed"))
+            }
+        }
+        return .success(Parsed(type: type, base64: body, blob: blob, line: fields.joined(separator: " ")))
+    }
+
+    public struct Refusal: Error, Equatable, Sendable {
+        public var reason: String
+        public init(_ reason: String) { self.reason = reason }
+    }
+
+    private static func isBase64Byte(_ b: UInt8) -> Bool {
+        (b >= 0x41 && b <= 0x5A) || (b >= 0x61 && b <= 0x7A) || (b >= 0x30 && b <= 0x39)
+            || b == 0x2B || b == 0x2F || b == 0x3D
+    }
+
+    private static func isCommentByte(_ b: UInt8) -> Bool {
+        (b >= 0x41 && b <= 0x5A) || (b >= 0x61 && b <= 0x7A) || (b >= 0x30 && b <= 0x39)
+            || b == 0x2D || b == 0x2E || b == 0x5F || b == 0x40 || b == 0x3A || b == 0x2B
+    }
+
+    /// True when `fileText` already holds this key (same type and key text,
+    /// whatever the comment or options in front of it).
+    public static func alreadyPresent(_ key: Parsed, in fileText: String) -> Bool {
+        for raw in fileText.split(whereSeparator: { $0 == "\n" || $0 == "\r" }) {
+            let fields = raw.split(whereSeparator: { $0 == " " || $0 == "\t" }).map(String.init)
+            guard let i = fields.firstIndex(where: { knownTypes.contains($0) }), i + 1 < fields.count else { continue }
+            if fields[i] == key.type && fields[i + 1] == key.base64 { return true }
+        }
+        return false
+    }
+}
+
+/// Appends a checked key to `<home>/.ssh/authorized_keys`.
+public struct TerminalKeyInstaller: Sendable {
+    public enum Outcome: Equatable, Sendable {
+        case installed(fingerprint: String)
+        case alreadyThere(fingerprint: String)
+        case refused(reason: String)
+    }
+
+    public var home: URL
+
+    public init(home: URL) { self.home = home }
+
+    #if os(macOS)
+    /// The account running this process.
+    public static func forCurrentUser() -> TerminalKeyInstaller {
+        TerminalKeyInstaller(home: FileManager.default.homeDirectoryForCurrentUser)
+    }
+    #endif
+
+    public func install(_ line: String) -> Outcome {
+        let key: TerminalKeyLine.Parsed
+        switch TerminalKeyLine.check(line) {
+        case let .success(k): key = k
+        case let .failure(r): return .refused(reason: r.reason)
+        }
+        let fm = FileManager.default
+        let ssh = home.appendingPathComponent(".ssh", isDirectory: true)
+        let file = ssh.appendingPathComponent("authorized_keys")
+        var isDir: ObjCBool = false
+        if fm.fileExists(atPath: ssh.path, isDirectory: &isDir) {
+            guard isDir.boolValue else { return .refused(reason: "~/.ssh is not a folder") }
+        } else {
+            do {
+                try fm.createDirectory(at: ssh, withIntermediateDirectories: false,
+                                       attributes: [.posixPermissions: 0o700])
+            } catch {
+                return .refused(reason: "could not make ~/.ssh")
+            }
+        }
+        // Never follow a link at the file itself.
+        if let type = try? fm.attributesOfItem(atPath: file.path)[.type] as? FileAttributeType,
+           type != .typeRegular {
+            return .refused(reason: "~/.ssh/authorized_keys is not a plain file")
+        }
+        let existing: Data
+        if fm.fileExists(atPath: file.path) {
+            guard let d = fm.contents(atPath: file.path) else {
+                return .refused(reason: "could not read ~/.ssh/authorized_keys")
+            }
+            existing = d
+        } else {
+            existing = Data()
+            guard fm.createFile(atPath: file.path, contents: nil, attributes: [.posixPermissions: 0o600]) else {
+                return .refused(reason: "could not make ~/.ssh/authorized_keys")
+            }
+        }
+        if TerminalKeyLine.alreadyPresent(key, in: String(decoding: existing, as: UTF8.self)) {
+            return .alreadyThere(fingerprint: key.fingerprint)
+        }
+        var add = Data()
+        if let last = existing.last, last != 0x0A { add.append(0x0A) }
+        add.append(contentsOf: Array(key.line.utf8))
+        add.append(0x0A)
+        // Append only: every byte already there stays as it was.
+        guard let h = try? FileHandle(forWritingTo: file) else {
+            return .refused(reason: "could not open ~/.ssh/authorized_keys")
+        }
+        defer { try? h.close() }
+        do {
+            try h.seekToEnd()
+            try h.write(contentsOf: add)
+        } catch {
+            return .refused(reason: "could not write ~/.ssh/authorized_keys")
+        }
+        return .installed(fingerprint: key.fingerprint)
+    }
+}
+
+/// What the app needs to know besides the key: is the SSH port listening, is tmux here.
+public enum TerminalKeyMacState {
+    /// Usual places tmux is installed (Homebrew on Apple silicon and Intel,
+    /// MacPorts, the system).
+    public static let tmuxPaths = ["/opt/homebrew/bin/tmux", "/usr/local/bin/tmux", "/opt/local/bin/tmux",
+                                   "/usr/bin/tmux"]
+
+    public static func tmuxPresent(paths: [String] = tmuxPaths) -> Bool {
+        paths.contains { FileManager.default.isExecutableFile(atPath: $0) }
+    }
+
+    /// True when something accepts a TCP connection on 127.0.0.1:`port`
+    /// (Remote Login listens on 22). Only connects and closes; sends nothing.
+    public static func listening(port: UInt16 = 22) -> Bool {
+        #if os(macOS)
+        let fd = socket(AF_INET, SOCK_STREAM, 0)
+        guard fd >= 0 else { return false }
+        defer { close(fd) }
+        var addr = sockaddr_in()
+        addr.sin_len = UInt8(MemoryLayout<sockaddr_in>.size)
+        addr.sin_family = sa_family_t(AF_INET)
+        addr.sin_port = port.bigEndian
+        addr.sin_addr.s_addr = inet_addr("127.0.0.1")
+        let r = withUnsafePointer(to: &addr) {
+            $0.withMemoryRebound(to: sockaddr.self, capacity: 1) {
+                connect(fd, $0, socklen_t(MemoryLayout<sockaddr_in>.size))
+            }
+        }
+        return r == 0
+        #else
+        return false
+        #endif
+    }
+
+    /// The answer to one request, from an installer outcome.
+    public static func result(requestID: UInt32, outcome: TerminalKeyInstaller.Outcome, userName: String,
+                              remoteLoginOn: Bool, tmuxPresent: Bool) -> WireTerminalKeyResult {
+        switch outcome {
+        case .installed:
+            WireTerminalKeyResult(requestID: requestID, status: .installed, remoteLoginOn: remoteLoginOn,
+                                  tmuxPresent: tmuxPresent, userName: userName)
+        case .alreadyThere:
+            WireTerminalKeyResult(requestID: requestID, status: .alreadyThere, remoteLoginOn: remoteLoginOn,
+                                  tmuxPresent: tmuxPresent, userName: userName)
+        case let .refused(reason):
+            WireTerminalKeyResult(requestID: requestID, status: .refused, remoteLoginOn: remoteLoginOn,
+                                  tmuxPresent: tmuxPresent, userName: userName, reason: reason)
+        }
+    }
+
+    /// One log line, never the key body.
+    public static func logLine(_ outcome: TerminalKeyInstaller.Outcome, viewer: String) -> String {
+        switch outcome {
+        case let .installed(fp): "terminal key \(fp) installed for viewer \"\(viewer)\""
+        case let .alreadyThere(fp): "terminal key \(fp) already there for viewer \"\(viewer)\""
+        case let .refused(reason): "terminal key refused for viewer \"\(viewer)\": \(reason)"
+        }
+    }
+}
