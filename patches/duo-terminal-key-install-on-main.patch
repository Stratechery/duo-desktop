diff --git a/Apps/Host/TerminalKeyHost.swift b/Apps/Host/TerminalKeyHost.swift
new file mode 100644
index 0000000..637202f
--- /dev/null
+++ b/Apps/Host/TerminalKeyHost.swift
@@ -0,0 +1,98 @@
+import AppKit
+import Foundation
+import GlassActCore
+import GlassActTransport
+import GlassActWire
+
+/// Duo Desktop build (terminal key): TERMINAL_KEY_INSTALL. The viewer of this
+/// session (approved by this Mac as a person's viewer, allowed to control) asks
+/// that its phone's SSH public key be added to this account's
+/// `~/.ssh/authorized_keys`, so its terminal signs in with no password. The
+/// line is checked strictly and appended; nothing is removed, no other account
+/// is touched, nothing from the request is run. One log line per request:
+/// fingerprint and viewer name, never the key.
+extension HostController {
+    /// Engine queue.
+    func handleTerminalKeyInstall(requestID: UInt32, keyLine: String, peer: QUICTransport.PeerCertificate?,
+                                  send: @escaping @Sendable (WireTerminalKeyResult) -> Void) {
+        let viewer: String = {
+            guard let fp = peer?.fingerprint else { return "unknown" }
+            let entry = authorizedViewers.all.first { $0.fingerprint == fp }
+            let name = [entry?.name, entry?.device].compactMap { $0 }.first { !$0.isEmpty }
+            return name ?? QUICIdentity.abbreviatedKeyString(fp)
+        }()
+        // Duo Desktop build (review fixes 2): an approval from before the Host recorded what it
+        // approved a key as. Ask this Mac's user once, record the answer, then decide as usual.
+        if authorizedViewers.needsSSHKeyQuestion(for: peer), let fp = peer?.fingerprint {
+            send(WireTerminalKeyResult(requestID: requestID, status: .askingOnMac, remoteLoginOn: false,
+                                       tmuxPresent: false, userName: NSUserName()))
+            DispatchQueue.main.async { [weak self] in
+                guard let self else { return }
+                guard SSHKeyQuestion.begin(fp) else {
+                    send(WireTerminalKeyResult(requestID: requestID, status: .refused, remoteLoginOn: false,
+                                               tmuxPresent: false, userName: NSUserName(),
+                                               reason: "this Mac is already asking about this device"))
+                    return
+                }
+                defer { SSHKeyQuestion.end(fp) }
+                // Asked only while nothing has decided it meanwhile (the list could change under the alert).
+                if self.authorizedViewers.needsSSHKeyQuestion(for: peer) {
+                    self.onStatus("viewer \"\(viewer)\" asks to add an SSH key: asking on this Mac")
+                    let allow = MainActor.assumeIsolated { SSHKeyQuestion.run(device: viewer) }
+                    do {
+                        try self.authorizedViewers.decideSSHKeys(fp, allow: allow)
+                        self.onStatus("SSH keys for viewer \"\(viewer)\": \(allow ? "allowed" : "not allowed") on this Mac")
+                    } catch {
+                        self.onStatus("could not save the SSH-key answer for \"\(viewer)\": \(error)")
+                    }
+                }
+                self.answerTerminalKeyInstall(requestID: requestID, keyLine: keyLine, peer: peer,
+                                              viewer: viewer, send: send)
+            }
+            return
+        }
+        answerTerminalKeyInstall(requestID: requestID, keyLine: keyLine, peer: peer, viewer: viewer, send: send)
+    }
+
+    private func answerTerminalKeyInstall(requestID: UInt32, keyLine: String, peer: QUICTransport.PeerCertificate?,
+                                          viewer: String, send: @escaping @Sendable (WireTerminalKeyResult) -> Void) {
+        let refusal = authorizedViewers.sshKeyRefusal(for: peer) // Duo Desktop build (review fixes)
+        DispatchQueue.global(qos: .userInitiated).async { [weak self] in
+            let outcome: TerminalKeyInstaller.Outcome = refusal.map { .refused(reason: $0) }
+                ?? TerminalKeyInstaller.forCurrentUser().install(keyLine)
+            let result = TerminalKeyMacState.result(
+                requestID: requestID, outcome: outcome, userName: NSUserName(),
+                remoteLoginOn: TerminalKeyMacState.listening(port: 22),
+                tmuxPresent: TerminalKeyMacState.tmuxPresent())
+            let line = TerminalKeyMacState.logLine(outcome, viewer: viewer)
+            DispatchQueue.main.async { self?.onStatus(line) }
+            send(result)
+        }
+    }
+}
+
+/// Duo Desktop build (review fixes 2): the one-time question for an approval made before the
+/// Host recorded SSH-key permission. A standard alert (HIG): the question as the title, what it
+/// means below, "Don't Allow" as the safe default. One question per device at a time. Main thread.
+enum SSHKeyQuestion {
+    nonisolated(unsafe) private static var open: Set<String> = []
+
+    static func begin(_ fingerprint: String) -> Bool { open.insert(fingerprint).inserted }
+    static func end(_ fingerprint: String) { open.remove(fingerprint) }
+
+    @MainActor static func run(device: String) -> Bool {
+        NSApp.activate()
+        let alert = NSAlert()
+        alert.alertStyle = .warning
+        alert.messageText = "Allow \(device) to add its SSH key to this Mac?"
+        alert.informativeText = """
+            \(device) can already see and control this Mac. Its SSH key would also let its Terminal \
+            sign in to this account without a password.
+            """
+        let deny = alert.addButton(withTitle: "Don’t Allow")
+        deny.keyEquivalent = "\r" // the safe answer is the default
+        alert.addButton(withTitle: "Allow").keyEquivalent = ""
+        alert.window.initialFirstResponder = deny
+        return alert.runModal() == .alertSecondButtonReturn
+    }
+}
diff --git a/Sources/GlassActCore/HostControlDelivery.swift b/Sources/GlassActCore/HostControlDelivery.swift
new file mode 100644
index 0000000..37b1448
--- /dev/null
+++ b/Sources/GlassActCore/HostControlDelivery.swift
@@ -0,0 +1,18 @@
+import Foundation
+
+/// Duo Desktop build (review fixes, review finding 2). Control bytes are authorized by the
+/// transport that DELIVERED them, not by whichever session is current when they are read.
+/// A transport's control callback can run, be delayed, and reach the engine queue after a
+/// new viewer was adopted; its bytes must then go nowhere: not to the new engine (which
+/// would act on them as the new viewer: a key install, the Mac password, input).
+public enum HostControlDelivery {
+    /// Engine queue. The engine that may read bytes delivered by `transport`: the current
+    /// one, only while `transport` is the session's transport and the engine was made on it.
+    /// nil = stale delivery; drop the bytes before any deframer sees them.
+    public static func engine(current: HostEngine?, sessionTransport: AnyObject?,
+                              deliveredBy transport: AnyObject?) -> HostEngine? {
+        guard let current, let transport, let sessionTransport, sessionTransport === transport,
+              current.isBound(to: transport) else { return nil }
+        return current
+    }
+}
