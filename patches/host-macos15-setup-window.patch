+    /// The setup and crash-notice windows: on macOS 27 SwiftUI sizes them
+    /// (`.preferredContentSize`). On macOS 15 that crashed at first launch
+    /// (the owner's MacBook, 15.7.5, 2026-11-21): each frame change made the hosting
+    /// view redo its title-bar safe area, which asked for another frame change,
+    /// until AppKit stopped the app. Below 27 the window is sized here instead,
+    /// from the content's fitting size, so SwiftUI never sets the frame.
+    private static var contentSizesWindow: Bool {
+        if #available(macOS 27, *) { return true }
+        return false
+    }
+
+    /// Below macOS 27 only, at creation and from the one-second check: size
+    /// the window to its content (following a row that grew or shrank). The
+    /// controller's `sizeThatFits` is used because with no sizing options the
+    /// view's `fittingSize` is zero; the title-bar inset counts only after a
+    /// layout pass. A no-op while the size already fits.
+    private func refitHandSizedWindows() {
+        guard !Self.contentSizesWindow else { return }
+        if let window = setupWindow, let hosting = window.contentViewController as? NSHostingController<SetupView> {
+            Self.fit(window, hosting)
+        }
+        if let window = crashNoticeWindow, let hosting = window.contentViewController as? NSHostingController<AnyView> {
+            Self.fit(window, hosting)
+        }
+    }
+
+    private static func fit<V: View>(_ window: NSWindow, _ hosting: NSHostingController<V>) {
+        window.layoutIfNeeded()
+        let fit = hosting.sizeThatFits(in: NSSize(width: 10_000, height: 10_000))
+        let now = window.contentRect(forFrameRect: window.frame).size
+        if fit.width >= 1, fit.height >= 1, abs(fit.width - now.width) >= 1 || abs(fit.height - now.height) >= 1 {
+            window.setContentSize(fit)
+        }
+    }
+
     private func finishSetup() {
         setupWindow?.close() // windowWillClose records completion
     }
