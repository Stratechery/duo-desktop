+    /// Duo Desktop build (auto-unlock). Main thread. The phone sent the Mac password (UNLOCK_TYPE): re-check the
+    /// lock RIGHT before typing, so it can never land in an ordinary window; locked → type it with Unicode key
+    /// events (no newline or tab meaning) and press Return. The bytes are never logged or stored; the local copy is
+    /// zeroed after typing. Answers UNLOCK_STATE; the lock check runs again soon so the phone hears "unlocked".
+    private func typeUnlockPassword(_ password: [UInt8]) {
+        var bytes = password
+        defer { for i in bytes.indices { bytes[i] = 0 } }
+        let reply: UInt8
+        if !TypingWatch.screenLocked() {
+            onStatus("unlock request: screen not locked, nothing typed")
+            reply = UnlockState.notLocked
+        } else if !ensureAccessibility() {
+            onStatus("unlock request: no Accessibility, nothing typed")
+            reply = UnlockState.failed
+        } else if var units = String(bytes: bytes, encoding: .utf8).map({ Array($0.utf16) }), !units.isEmpty {
+            var i = 0
+            while i < units.count {
+                var end = min(i + 20, units.count)
+                if end < units.count, UTF16.isTrailSurrogate(units[end]) { end -= 1 }
+                let chunk = Array(units[i..<end])
+                for down in [true, false] {
+                    guard let ev = CGEvent(keyboardEventSource: nil, virtualKey: 0, keyDown: down) else { continue }
+                    ev.flags = []
+                    ev.keyboardSetUnicodeString(stringLength: chunk.count, unicodeString: chunk)
+                    ev.post(tap: .cghidEventTap)
+                }
+                i = end
+            }
+            for down in [true, false] {
+                CGEvent(keyboardEventSource: nil, virtualKey: 36, keyDown: down)?.post(tap: .cghidEventTap)
+            }
+            onStatus("unlock request: typed \(units.count) characters and Return")
+            for j in units.indices { units[j] = 0 }
+            reply = UnlockState.typed
+        } else {
+            onStatus("unlock request: not readable text, nothing typed")
+            reply = UnlockState.failed
+        }
+        encodeQueue.async { self.engine?.sendUnlockState(reply) }
+        if reply == UnlockState.typed { typingWatch.checkLockSoon() }
+    }
