diff --git a/Sources/GlassActCore/UnlockTypingGate.swift b/Sources/GlassActCore/UnlockTypingGate.swift
new file mode 100644
index 0000000..8b2dbc6
--- /dev/null
+++ b/Sources/GlassActCore/UnlockTypingGate.swift
@@ -0,0 +1,84 @@
+// Duo Desktop build (auto-unlock): WHEN the Host types the Mac password.
+//
+// The Host used to type the moment the phone's request arrived. When the Mac locks during a session, the phone hears
+// "locked" and asks at once (26 ms later on a test Mac), before the lock screen's password field exists, so
+// the keystrokes went nowhere. The gate waits until the lock screen can take the password: the Mac is still locked,
+// its display is awake (asleep → the Host wakes it), and the lock screen's password field has the keyboard (secure
+// keyboard entry is on, or the lock screen's window is on screen), held for a short settle time. If the field signal
+// never shows, a display that has stayed awake and locked for `fallbackSettle` counts as ready (the lock screen's
+// own animation takes well under a second). Pure and step-driven so it can be tested without a Mac's lock screen.
+// It never sees the password.
+
+/// What the Host can see of the lock screen right now (no new permission needed for any of it).
+public struct UnlockLockScreen: Equatable, Sendable {
+    /// The session reports the screen locked.
+    public var locked: Bool
+    /// The main display is awake.
+    public var displayAwake: Bool
+    /// The lock screen's password field has the keyboard (secure keyboard entry on) or its window is on screen.
+    public var fieldReady: Bool
+
+    public init(locked: Bool, displayAwake: Bool, fieldReady: Bool) {
+        self.locked = locked
+        self.displayAwake = displayAwake
+        self.fieldReady = fieldReady
+    }
+}
+
+public struct UnlockTypingGate: Sendable {
+    public enum Step: Equatable, Sendable {
+        /// Not ready yet: look again shortly.
+        case wait
+        /// The display is asleep: wake it (and look again).
+        case wakeDisplay
+        /// Ready: type the password and Return now. Given once.
+        case type(fieldSeen: Bool)
+        /// The screen is no longer locked: type nothing.
+        case notLocked
+        /// The lock screen never became ready in time: type nothing.
+        case notReady
+        /// The gate already gave its answer.
+        case finished
+    }
+
+    /// How often the Host looks.
+    public static let interval: Double = 0.1
+    /// The ready state must hold this long before typing.
+    public static let settle: Double = 0.4
+    /// Awake and locked this long with no field signal also counts as ready.
+    public static let fallbackSettle: Double = 2.5
+    /// Give up (type nothing) after this long.
+    public static let deadline: Double = 10
+    /// While the display stays asleep, wake it again this often.
+    public static let wakeEvery: Double = 2
+
+    private let start: Double
+    private var awakeSince: Double?
+    private var fieldSince: Double?
+    private var lastWake: Double?
+    public private(set) var finished = false
+
+    public init(now: Double) { start = now }
+
+    public mutating func step(now: Double, _ s: UnlockLockScreen) -> Step {
+        guard !finished else { return .finished }
+        guard s.locked else { finished = true; return .notLocked }
+        guard s.displayAwake else {
+            awakeSince = nil; fieldSince = nil
+            if now - start >= Self.deadline { finished = true; return .notReady }
+            if let w = lastWake, now - w < Self.wakeEvery { return .wait }
+            lastWake = now
+            return .wakeDisplay
+        }
+        if awakeSince == nil { awakeSince = now }
+        if s.fieldReady {
+            if fieldSince == nil { fieldSince = now }
+        } else {
+            fieldSince = nil
+        }
+        if let f = fieldSince, now - f >= Self.settle { finished = true; return .type(fieldSeen: true) }
+        if let a = awakeSince, now - a >= Self.fallbackSettle { finished = true; return .type(fieldSeen: false) }
+        if now - start >= Self.deadline { finished = true; return .notReady }
+        return .wait
+    }
+}
