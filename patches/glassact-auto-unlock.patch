diff --git a/Tests/CoreTests/UnlockTypingGateTests.swift b/Tests/CoreTests/UnlockTypingGateTests.swift
new file mode 100644
index 0000000..378b0a5
--- /dev/null
+++ b/Tests/CoreTests/UnlockTypingGateTests.swift
@@ -0,0 +1,78 @@
+// Duo Desktop build (auto-unlock): the Host types only when the lock screen
+// can take the password, and exactly once.
+import XCTest
+@testable import GlassActCore
+
+final class UnlockTypingGateTests: XCTestCase {
+    private func run(_ screen: (TimeInterval) -> UnlockLockScreen, until: TimeInterval = 15)
+        -> (types: [(TimeInterval, Bool)], wakes: [TimeInterval], end: UnlockTypingGate.Step?) {
+        var gate = UnlockTypingGate(now: 0)
+        var types: [(TimeInterval, Bool)] = [], wakes: [TimeInterval] = [], end: UnlockTypingGate.Step?
+        var t: TimeInterval = 0
+        while t <= until {
+            switch gate.step(now: t, screen(t)) {
+            case let .type(seen): types.append((t, seen))
+            case .wakeDisplay: wakes.append(t)
+            case .notLocked: end = .notLocked
+            case .notReady: end = .notReady
+            case .wait, .finished: break
+            }
+            t += UnlockTypingGate.interval
+            t = (t * 10).rounded() / 10
+        }
+        return (types, wakes, end)
+    }
+
+    /// Claim: a lock during a session (password field appears 0.8 s after the lock): nothing is typed before the field
+    /// is there and settled, then it is typed exactly once.
+    func testTypesOnceOnlyAfterFieldReadyAndSettled() {
+        let r = run { t in UnlockLockScreen(locked: true, displayAwake: true, fieldReady: t >= 0.8) }
+        XCTAssertEqual(r.types.count, 1)
+        XCTAssertEqual(r.types.first!.0, 0.8 + UnlockTypingGate.settle, accuracy: 0.11)
+        XCTAssertTrue(r.types.first!.1, "typed on the field signal")
+        XCTAssertTrue(r.wakes.isEmpty)
+    }
+
+    /// Claim: the field flickering (shown, gone, back) restarts the settle time.
+    func testFieldMustHoldForSettle() {
+        let r = run { t in UnlockLockScreen(locked: true, displayAwake: true, fieldReady: t >= 0.2 && !(0.4...0.5).contains(t)) }
+        XCTAssertEqual(r.types.count, 1)
+        XCTAssertGreaterThanOrEqual(r.types.first!.0, 0.6 + UnlockTypingGate.settle - 0.01)
+    }
+
+    /// Claim: a Mac whose display is asleep is woken first and typed into only once it is awake and ready.
+    func testAsleepDisplayIsWokenFirst() {
+        let r = run { t in UnlockLockScreen(locked: true, displayAwake: t >= 1.0, fieldReady: t >= 1.3) }
+        XCTAssertEqual(r.wakes.first, 0)
+        XCTAssertEqual(r.types.count, 1)
+        XCTAssertGreaterThanOrEqual(r.types.first!.0, 1.3 + UnlockTypingGate.settle - 0.01)
+    }
+
+    /// Claim: with no field signal at all, an awake, locked display counts as ready only after the longer settle.
+    func testFallbackAfterAwakeAndLocked() {
+        let r = run { _ in UnlockLockScreen(locked: true, displayAwake: true, fieldReady: false) }
+        XCTAssertEqual(r.types.count, 1)
+        XCTAssertEqual(r.types.first!.0, UnlockTypingGate.fallbackSettle, accuracy: 0.11)
+        XCTAssertFalse(r.types.first!.1)
+    }
+
+    /// Claim: a display that never wakes is never typed into; the gate gives up at its deadline.
+    func testNeverAwakeGivesUp() {
+        var gate = UnlockTypingGate(now: 0)
+        var steps: [UnlockTypingGate.Step] = []
+        var t: TimeInterval = 0
+        while t <= 12 { steps.append(gate.step(now: t, UnlockLockScreen(locked: true, displayAwake: false, fieldReady: false))); t += 0.1 }
+        XCTAssertFalse(steps.contains { if case .type = $0 { true } else { false } })
+        XCTAssertTrue(steps.contains(.notReady))
+        XCTAssertGreaterThan(steps.filter { $0 == .wakeDisplay }.count, 1, "woken again while it stays asleep")
+        XCTAssertEqual(steps.last, .finished)
+    }
+
+    /// Claim: unlocked meanwhile (by hand) → nothing typed.
+    func testUnlockedMeanwhileTypesNothing() {
+        var gate = UnlockTypingGate(now: 0)
+        XCTAssertEqual(gate.step(now: 0, UnlockLockScreen(locked: true, displayAwake: true, fieldReady: false)), .wait)
+        XCTAssertEqual(gate.step(now: 0.1, UnlockLockScreen(locked: false, displayAwake: true, fieldReady: true)), .notLocked)
+        XCTAssertEqual(gate.step(now: 0.6, UnlockLockScreen(locked: true, displayAwake: true, fieldReady: true)), .finished)
+    }
+}
diff --git a/Tests/WireTests/UnlockMessageTests.swift b/Tests/WireTests/UnlockMessageTests.swift
new file mode 100644
index 0000000..3483ecb
--- /dev/null
+++ b/Tests/WireTests/UnlockMessageTests.swift
@@ -0,0 +1,44 @@
+// Duo Desktop build (auto-unlock): UNLOCK_TYPE (0x67) and UNLOCK_STATE (0x68) on the wire. A made-up word only.
+import XCTest
+@testable import GlassActWire
+
+final class UnlockMessageTests: XCTestCase {
+    let word = Array("pumpernickel-42".utf8)
+
+    func testBothRoundTrip() {
+        let type = ControlMessage.unlockType(password: word)
+        let states = [UnlockState.available, UnlockState.typed, UnlockState.notLocked, UnlockState.failed]
+            .map { ControlMessage.unlockState(state: $0) }
+        XCTAssertEqual(type.tlvType, 0x67); XCTAssertEqual(states[0].tlvType, 0x68)
+        var d = ControlDeframer()
+        d.append(type.encoded()); states.forEach { d.append($0.encoded()) }
+        XCTAssertEqual(d.next(), .message(type))
+        for s in states { XCTAssertEqual(d.next(), .message(s)) }
+        XCTAssertTrue(ControlMessage.isKnownType(0x67)); XCTAssertTrue(ControlMessage.isKnownType(0x68))
+    }
+
+    /// Empty or longer than 256 bytes: refused by the decoder.
+    func testLengthLimits() {
+        func parse(_ bytes: [UInt8]) -> ControlMessage? {
+            var body = ByteWriter(reserving: bytes.count + 3)
+            body.writeVarint(UInt32(bytes.count)); body.writeBytes(bytes)
+            return body.bytes.withUnsafeBytes { ControlMessage.parseBody(type: 0x67, $0) }
+        }
+        XCTAssertNil(parse([]))
+        XCTAssertNil(parse([UInt8](repeating: 0x61, count: UnlockState.maxPasswordBytes + 1)))
+        let max = [UInt8](repeating: 0x61, count: UnlockState.maxPasswordBytes)
+        XCTAssertEqual(parse(max), .unlockType(password: max))
+    }
+
+    /// An older peer doesn't know the types: it skips them by length and the next message still arrives.
+    func testOlderPeerSkipsThem() {
+        var t = ControlMessage.unlockType(password: word).encoded(); t[0] = 0x7E
+        var s = ControlMessage.unlockState(state: UnlockState.available).encoded(); s[0] = 0x7E
+        let after = ControlMessage.hostNotice(code: HostNotice.none)
+        var d = ControlDeframer()
+        d.append(t); d.append(s); d.append(after.encoded())
+        XCTAssertEqual(d.next(), .skippedUnknown(type: 0x7E))
+        XCTAssertEqual(d.next(), .skippedUnknown(type: 0x7E))
+        XCTAssertEqual(d.next(), .message(after))
+    }
+}
