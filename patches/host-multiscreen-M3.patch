+    // MARK: - Duo Screens build (multi-screen): the viewer's screen choice
+
+    /// Main thread. DISPLAY_SELECT: 0 = send the list; else share that screen in session (re-HELLO,
+    /// no reconnect), place the pointer on it (a drag if a button is held), and answer with
+    /// DISPLAY_SELECTED once the new session runs, or a refusal at once.
+    private func handleDisplaySelect(_ id: UInt32, pointer asked: CGPoint?) {
+        if id == 0 {
+            viewerWantsDisplayList = true
+            sendDisplayList()
+            return
+        }
+        func answerNow(_ status: WireDisplaySelection.Status, _ why: String) {
+            let cur = physicalDisplay, b = CGDisplayBounds(cur)
+            let answer = WireDisplaySelection(requestedID: id, status: status, displayID: cur,
+                                              x: Int32(b.minX), y: Int32(b.minY),
+                                              width: UInt16(clamping: Int(b.width)), height: UInt16(clamping: Int(b.height)),
+                                              pictureWidth: UInt16(clamping: captureWidth),
+                                              pictureHeight: UInt16(clamping: captureHeight))
+            onStatus("screen choice \(id) refused: \(why)")
+            encodeQueue.async { [weak self] in self?.engine?.sendDisplaySelected(answer) }
+        }
+        guard isRunning, lastFilter != nil, singleWindowID == 0, virtualDisplay == nil, !displaySwitchInProgress else {
+            answerNow(.notNow, displaySwitchInProgress ? "another switch is under way"
+                               : "not sharing a whole screen right now")
+            return
+        }
+        displaySwitchInProgress = true
+        Task {
+            let content = try? await SCShareableContent.excludingDesktopWindows(false, onScreenWindowsOnly: false)
+            await MainActor.run {
+                let offered = (content?.displays ?? []).map(\.displayID)
+                let chosen = DisplayChoice.screenToShare(requested: id, offered: offered, main: CGMainDisplayID())
+                guard chosen == id, let scDisplay = content?.displays.first(where: { $0.displayID == id }),
+                      self.isRunning, self.transport != nil else {
+                    self.displaySwitchInProgress = false
+                    answerNow(.notOffered, "display \(id) is not offered (offered: \(offered))")
+                    return
+                }
+                self.switchDisplay(to: scDisplay, requested: id, pointer: asked)
+            }
+        }
+    }
+
+    /// Main thread.
+    private func switchDisplay(to display: SCDisplay, requested id: UInt32, pointer asked: CGPoint?) {
+        let did = display.displayID
+        let bounds = CGDisplayBounds(did)
+        let filter = SCContentFilter(display: display, excludingWindows: [])
+        let previousFilter = lastFilter, previousChosen = chosenDisplayID
+        chosenDisplayID = did
+        sharedDisplayID = did
+        lastFilter = filter
+        // The size: Scale fits this screen into the viewer's request; else the screen's own pixels.
+        var pw: Int, ph: Int
+        if let request = lastScaleRequest {
+            (pw, ph) = CaptureGeometry.scaledSize(of: bounds.size, toFit: request,
+                                                  maxPixelsPerPoint: Self.pixelsPerPoint(did))
+        } else if let mode = CGDisplayCopyDisplayMode(did) {
+            (pw, ph) = (mode.pixelWidth, mode.pixelHeight)
+        } else {
+            (pw, ph) = (Int(bounds.width), Int(bounds.height))
+        }
+        // The half-size picture stays in force on a switch (its full size follows the new screen).
+        if autoScaledDown {
+            autoScaleFull = (pw, ph, CGFloat(pw) / max(1, bounds.width))
+            pw = (pw / 2) & ~1
+            ph = (ph / 2) & ~1
+        }
+        let rect = DisplayChoice.Rect(x: bounds.minX, y: bounds.minY, width: bounds.width, height: bounds.height)
+        let placed = DisplayChoice.pointerPlacement(asked: asked.map { (Double($0.x), Double($0.y)) }, on: rect)
+        let size = CaptureGeometry.clamp(pw, ph)
+        onStatus("screen choice \(id): sharing display \(did) at \(Int(bounds.minX)),\(Int(bounds.minY)) "
+                 + "\(Int(bounds.width))×\(Int(bounds.height)) pt, picture \(size.w)×\(size.h)"
+                 + (autoScaledDown ? " (half size kept)" : ""))
+        let restarted = restartCapture(pixelWidth: pw, pixelHeight: ph, pointScale: CGFloat(pw) / max(1, bounds.width),
+                                       origin: bounds.origin, inSession: true)
+        guard restarted else {
+            // The capture could not be rebuilt: put the old one back as it was and say so.
+            chosenDisplayID = previousChosen
+            lastFilter = previousFilter
+            displaySwitchInProgress = false
+            let answer = WireDisplaySelection(requestedID: id, status: .failed, displayID: physicalDisplay)
+            onStatus("screen choice \(id): capture could not be rebuilt — ending the session")
+            encodeQueue.async { [weak self] in self?.engine?.sendDisplaySelected(answer) }
+            disconnectViewer(status: "screen switch failed — viewer disconnected")
+            return
+        }
+        // After restartCapture's engine swap (same queue, queued after it): place the pointer, then
+        // queue the answer for the tick to send once the new session runs.
+        let answer = WireDisplaySelection(requestedID: id, status: .ok, displayID: did,
+                                          x: Int32(bounds.minX), y: Int32(bounds.minY),
+                                          width: UInt16(clamping: Int(bounds.width)),
+                                          height: UInt16(clamping: Int(bounds.height)),
+                                          pictureWidth: UInt16(clamping: size.w), pictureHeight: UInt16(clamping: size.h),
+                                          pointerPlaced: true,
+                                          pointerX: Int32(placed.x.rounded()), pointerY: Int32(placed.y.rounded()))
+        let pt = CGPoint(x: placed.x, y: placed.y)
+        encodeQueue.async { [weak self] in
+            guard let self else { return }
+            if AXIsProcessTrusted() {
+                if self.mouseButtonsDown != 0 {
+                    let (type, button) = self.draggedTypeForHeldButton()
+                    self.post(mouse: type, at: pt, button: button, clickState: self.heldClickState)
+                } else {
+                    self.post(mouse: .mouseMoved, at: pt, button: .left)
+                }
+            }
+            self.pendingDisplaySelected = answer
+            self.pendingDisplayListAfterSwitch = true
+            DispatchQueue.main.async { self.displaySwitchInProgress = false }
+        }
+    }
+
+    /// Main thread. DISPLAY_LIST: every display capture can see, with its place, size and a small
+    /// picture, the shown one marked.
+    private func sendDisplayList() {
+        let shown = physicalDisplay, main = CGMainDisplayID()
+        Task {
+            guard let content = try? await SCShareableContent.excludingDesktopWindows(false, onScreenWindowsOnly: false)
+            else { return }
+            var names: [CGDirectDisplayID: String] = [:]
+            await MainActor.run {
+                for screen in NSScreen.screens {
+                    if let n = screen.deviceDescription[NSDeviceDescriptionKey("NSScreenNumber")] as? NSNumber {
+                        names[CGDirectDisplayID(n.uint32Value)] = screen.localizedName
+                    }
+                }
+            }
+            var list: [WireDisplay] = []
+            for d in content.displays.prefix(16) {
+                let id = d.displayID
+                let b = CGDisplayBounds(id)
+                let ppp = Int((Self.pixelsPerPoint(id) * 100).rounded())
+                let thumb = await Self.displayThumbnail(d)
+                list.append(WireDisplay(displayID: id, name: names[id] ?? "Display \(id)",
+                                        x: Int32(b.minX), y: Int32(b.minY),
+                                        width: UInt16(clamping: Int(b.width)), height: UInt16(clamping: Int(b.height)),
+                                        pixelsPerPoint100: UInt16(clamping: ppp),
+                                        rotation: UInt16(Int(CGDisplayRotation(id)) % 360),
+                                        isMain: id == main, isShown: id == shown,
+                                        thumbFormat: thumb?.format ?? WindowThumbFormat.none,
+                                        thumbWidth: UInt16(clamping: thumb?.width ?? 0),
+                                        thumbHeight: UInt16(clamping: thumb?.height ?? 0),
+                                        thumb: thumb?.bytes ?? []))
+            }
+            self.encodeQueue.async { [list] in self.engine?.sendDisplayList(list) }
+            self.onStatus("sent \(list.count) screens to viewer: " + list.map {
+                "\($0.displayID) \($0.name) \($0.width)×\($0.height) at \($0.x),\($0.y)\($0.isMain ? " main" : "")\($0.isShown ? " shown" : "")"
+            }.joined(separator: "; "))
+        }
+    }
+
+    /// A small still of a whole display (at most 320 × 200), as the window list's pictures.
+    private static func displayThumbnail(_ display: SCDisplay) async -> (format: UInt8, width: Int, height: Int, bytes: [UInt8])? {
+        let fw = max(CGFloat(display.width), 1), fh = max(CGFloat(display.height), 1)
+        let f = min(320.0 / fw, 200.0 / fh, 1.0)
+        let config = SCStreamConfiguration()
+        config.width = max(2, Int(fw * f)) & ~1
+        config.height = max(2, Int(fh * f)) & ~1
+        config.pixelFormat = kCVPixelFormatType_32BGRA
+        config.colorSpaceName = CGColorSpace.sRGB
+        config.showsCursor = false
+        guard let cg = try? await SCScreenshotManager.captureImage(
+                contentFilter: SCContentFilter(display: display, excludingWindows: []), configuration: config),
+              let encoded = encodeThumbnail(cg) else { return nil }
+        return (encoded.format, cg.width, cg.height, encoded.bytes)
+    }
