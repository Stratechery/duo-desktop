+// Duo Desktop build: SCREEN_LOCK (0x63) and TEXT_FOCUS (0x64) on the wire.
+import XCTest
+@testable import GlassActWire
+
+final class TypingNoticesTests: XCTestCase {
+    func testBothRoundTrip() {
+        let f = ControlMessage.textFocus(WireTextFocus(hasText: true, fieldX: -1900, fieldY: 118, fieldW: 656, fieldH: 384,
+                                                       caretX: 223, caretY: 130, caretW: 1, caretH: 13))
+        let none = ControlMessage.textFocus(.none)
+        let lock = ControlMessage.screenLock(state: ScreenLock.locked)
+        XCTAssertEqual(f.tlvType, 0x64); XCTAssertEqual(lock.tlvType, 0x63)
+        var d = ControlDeframer()
+        d.append(f.encoded()); d.append(none.encoded()); d.append(lock.encoded())
+        XCTAssertEqual(d.next(), .message(f))
+        XCTAssertEqual(d.next(), .message(none))
+        XCTAssertEqual(d.next(), .message(lock))
+    }
+
+    /// An older peer doesn't know the types: it skips them by length and the next message still arrives.
+    /// Simulated by re-typing the same bodies to a type nobody knows (0x7E).
+    func testOlderPeerSkipsThem() {
+        XCTAssertFalse(ControlMessage.isKnownType(0x7E))
+        var stale = ControlMessage.textFocus(WireTextFocus(hasText: true, fieldW: 10, fieldH: 10)).encoded()
+        stale[0] = 0x7E
+        var lock = ControlMessage.screenLock(state: 1).encoded()
+        lock[0] = 0x7E
+        let after = ControlMessage.hostNotice(code: HostNotice.none)
+        var d = ControlDeframer()
+        d.append(stale); d.append(lock); d.append(after.encoded())
+        XCTAssertEqual(d.next(), .skippedUnknown(type: 0x7E))
+        XCTAssertEqual(d.next(), .skippedUnknown(type: 0x7E))
+        XCTAssertEqual(d.next(), .message(after))
+        XCTAssertFalse(d.isMalformed)
+    }
+
+    /// No text content can cross the wire: the notice has only numbers and a flag, and its body is a
+    /// fixed 25 bytes whatever is focused.
+    func testTextFocusCarriesNoString() {
+        for child in Mirror(reflecting: WireTextFocus(hasText: true)).children {
+            XCTAssertTrue(child.value is Int32 || child.value is UInt16 || child.value is Bool,
+                          "\(child.label ?? "?") is \(type(of: child.value)), not a number")
+        }
+        for f in [WireTextFocus.none, WireTextFocus(hasText: true, fieldX: 1, fieldY: 2, fieldW: 3, fieldH: 4)] {
+            let bytes = ControlMessage.textFocus(f).encoded()
+            XCTAssertEqual(bytes.count, 2 + WireTextFocus.bodyLength) // type + 1-byte varint length + body
+        }
+    }
+}
