diff --git a/Tests/SessionTests/RealHostTextFocusProofTests.swift b/Tests/SessionTests/RealHostTextFocusProofTests.swift
new file mode 100644
index 0000000..dd37f40
--- /dev/null
+++ b/Tests/SessionTests/RealHostTextFocusProofTests.swift
@@ -0,0 +1,121 @@
+// Duo Desktop build (text focus + lock), proof on this Mac's own Host (127.0.0.1:4433): a viewer clicks
+// into apps and prints the TEXT_FOCUS and SCREEN_LOCK notices the Host sends. Skipped unless
+// GLASSACT_REALHOST_PORT is set. GLASSACT_PROOF_DIR: the viewer key. Never types anything.
+import XCTest
+import AppKit
+import CoreGraphics
+import GlassActCore
+@testable import GlassActSession
+import GlassActTransport
+import GlassActWire
+
+final class RealHostTextFocusProofTests: XCTestCase {
+    @MainActor
+    func spin(_ seconds: Double, until done: () -> Bool = { false }) {
+        let end = Date().addingTimeInterval(seconds)
+        while !done(), Date() < end { RunLoop.main.run(until: Date().addingTimeInterval(0.02)) }
+    }
+
+    /// The largest on-screen window of an app (CGWindowList bounds: no permission needed).
+    func window(of owner: String) -> CGRect? {
+        let list = CGWindowListCopyWindowInfo([.optionOnScreenOnly, .excludeDesktopElements], kCGNullWindowID) as? [[String: Any]] ?? []
+        return list.filter { ($0[kCGWindowOwnerName as String] as? String) == owner && ($0[kCGWindowLayer as String] as? Int) == 0 }
+            .compactMap { w -> CGRect? in
+                guard let b = w[kCGWindowBounds as String] as? NSDictionary else { return nil }
+                return CGRect(dictionaryRepresentation: b)
+            }
+            .max { $0.width * $0.height < $1.width * $1.height }
+    }
+
+    func describe(_ f: WireTextFocus?) -> String {
+        guard let f else { return "nothing received" }
+        guard f.hasText else { return "none (not a text place)" }
+        return "text: field \(f.fieldX),\(f.fieldY) \(f.fieldW)x\(f.fieldH); caret \(f.caretX),\(f.caretY) \(f.caretW)x\(f.caretH)"
+    }
+
+    @MainActor
+    func testTextFocusAndLock() throws {
+        guard let portText = ProcessInfo.processInfo.environment["GLASSACT_REALHOST_PORT"],
+              let port = UInt16(portText) else { throw XCTSkip("no real host (GLASSACT_REALHOST_PORT)") }
+        let dir = URL(fileURLWithPath: ProcessInfo.processInfo.environment["GLASSACT_PROOF_DIR"] ?? NSTemporaryDirectory())
+        let id = try QUICIdentity.loadOrCreate(directory: dir, name: "proof-viewer-identity", commonName: "duo-proof")
+        print("proof: viewer fingerprint \(try QUICIdentity.fingerprint(of: id))")
+
+        let session = ViewerSession(host: "127.0.0.1", port: port, fingerprint: "", identity: id,
+                                    options: .init(cursorMetadata: true, video: false, deviceName: "duo-proof"))
+        let lock = NSLock()
+        var focuses: [WireTextFocus] = []
+        var locks: [UInt8] = []
+        session.engine.onTextFocus = { f in lock.lock(); focuses.append(f); lock.unlock() }
+        session.engine.onScreenLock = { s in lock.lock(); locks.append(s); lock.unlock() }
+        func latest() -> WireTextFocus? { lock.lock(); defer { lock.unlock() }; return focuses.last }
+        func count() -> Int { lock.lock(); defer { lock.unlock() }; return focuses.count }
+        let main = CGDisplayBounds(CGMainDisplayID())
+        session.setRequestedGeometry(mode: 2, widthPoints: Int(main.width), heightPoints: Int(main.height), scale: 1)
+        session.start()
+        spin(15) { session.configuredGrid() != nil }
+        let grid = try XCTUnwrap(session.configuredGrid(), "connected")
+        spin(3)
+        lock.lock(); let lockSeen = locks; lock.unlock()
+        print("proof: SCREEN_LOCK on connect: \(lockSeen) (0 = unlocked, 1 = locked)")
+        XCTAssertEqual(lockSeen.last, ScreenLock.unlocked, "an unlocked Mac reports unlocked on connect")
+
+        func click(_ p: CGPoint) {
+            let x = Int((p.x - main.minX) / main.width * CGFloat(grid.width))
+            let y = Int((p.y - main.minY) / main.height * CGFloat(grid.height))
+            session.sendInput(kind: 1, x: x, y: y, a: 0, b: 0)
+            spin(0.15)
+            session.sendInput(kind: 2, x: x, y: y, a: 1, b: 0)
+            spin(0.08)
+            session.sendInput(kind: 3, x: x, y: y, a: 1, b: 0)
+        }
+        func after(_ label: String, _ action: () -> Void) -> WireTextFocus? {
+            let before = count()
+            action()
+            spin(2.5) { count() > before }
+            spin(0.5)
+            let f = latest()
+            print("proof: \(label): \(describe(count() > before ? f : nil)) [latest overall: \(describe(f))]")
+            return count() > before ? f : f
+        }
+
+        // TextEdit: a new plain document, click in the middle of its window.
+        let doc = dir.appendingPathComponent("textfocus-proof.txt")
+        try "".write(to: doc, atomically: true, encoding: .utf8)
+        NSWorkspace.shared.open([doc], withApplicationAt: URL(fileURLWithPath: "/System/Applications/TextEdit.app"),
+                                configuration: NSWorkspace.OpenConfiguration())
+        spin(3) { window(of: "TextEdit") != nil }
+        let te = try XCTUnwrap(window(of: "TextEdit"), "TextEdit window")
+        print("proof: TextEdit window \(te)")
+        let t = after("click into TextEdit's text") { click(CGPoint(x: te.midX, y: te.midY)) }
+        XCTAssertEqual(t?.hasText, true, "TextEdit reports a text place")
+        if let t, t.hasText {
+            let field = CGRect(x: CGFloat(t.fieldX), y: CGFloat(t.fieldY), width: CGFloat(t.fieldW), height: CGFloat(t.fieldH))
+            XCTAssertTrue(te.insetBy(dx: -2, dy: -2).contains(field.insetBy(dx: 1, dy: 1)) || te.intersects(field), "field is inside the window")
+            XCTAssertTrue(te.contains(CGPoint(x: CGFloat(t.caretX), y: CGFloat(t.caretY))), "caret is inside the window")
+        }
+
+        // The desktop: a spot no window covers (bottom-left of the main screen, below the windows).
+        let d = after("click on the desktop") { click(CGPoint(x: main.minX + 60, y: main.maxY - 40)) }
+        XCTAssertEqual(d?.hasText, false, "the desktop is not a text place")
+
+        // Other apps: activated, then a click in the middle of their window (Terminal) or no click (Claude,
+        // Chrome: their focus is whatever they had; we only report what they answer).
+        for (app, owner, doClick) in [("Terminal", "Terminal", true), ("Google Chrome", "Google Chrome", false),
+                                      ("Claude", "Claude", false)] {
+            let url = NSWorkspace.shared.urlForApplication(withBundleIdentifier: [
+                "Terminal": "com.apple.Terminal", "Google Chrome": "com.google.Chrome", "Claude": "com.anthropic.claudefordesktop",
+            ][app]!)
+            guard let url else { print("proof: \(app): not installed"); continue }
+            _ = after("\(app) activated" + (doClick ? " and clicked in its window" : "")) {
+                NSWorkspace.shared.openApplication(at: url, configuration: NSWorkspace.OpenConfiguration())
+                spin(2)
+                if doClick, let w = window(of: owner) { click(CGPoint(x: w.midX, y: w.midY)) }
+            }
+        }
+
+        // Close the proof document's TextEdit window without saving anything typed (nothing was typed).
+        session.stop()
+        spin(1)
+    }
+}
