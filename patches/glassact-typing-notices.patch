diff --git a/Apps/Host/TypingWatch.swift b/Apps/Host/TypingWatch.swift
new file mode 100644
index 0000000..2183174
--- /dev/null
+++ b/Apps/Host/TypingWatch.swift
@@ -0,0 +1,195 @@
+// Duo Desktop build (text focus + lock): tells the phone where typing goes on
+// this Mac and whether its screen is locked.
+//
+// Privacy rule (the owner's order): only role-level facts and frames are read. No
+// value, title, description, selected text or any other string of the element
+// is read or sent. The wire message (TEXT_FOCUS) has no string field at all.
+//
+// Lock: `CGSessionCopyCurrentDictionary()` is public API (documented keys:
+// kCGSessionOnConsoleKey, kCGSessionLoginDoneKey). The "CGSSessionScreenIsLocked"
+// key in that dictionary and the "com.apple.screenIsLocked" / "…Unlocked"
+// distributed notifications are NOT documented by Apple; they are what macOS
+// has used for years and what this Mac shows. A 2 s check backs the
+// notifications up, and "not on console" (login window, other user) counts as
+// locked for typing purposes.
+import AppKit
+import ApplicationServices
+import Foundation
+import GlassActCore
+import GlassActWire
+
+final class TypingWatch: @unchecked Sendable {
+    private let queue = DispatchQueue(label: "duo.typing-watch")
+    /// Runs a block with the engine on the queue that owns it (the Host's
+    /// encode queue); nil = no viewer.
+    /// Set once by the Host right after it is made.
+    var perform: (@escaping @Sendable (HostEngine?) -> Void) -> Void = { _ in }
+    private var lastFocus: WireTextFocus?
+    private var lastQueryAt: TimeInterval = 0
+    private var queryPending = false
+    private var timer: DispatchSourceTimer?
+    private var lockTimer: DispatchSourceTimer?
+    private var lastLock: UInt8?
+    private static let minGap: TimeInterval = 0.15
+
+    var log: (String) -> Void = { _ in }
+
+    init() {
+        let dnc = DistributedNotificationCenter.default()
+        for name in ["com.apple.screenIsLocked", "com.apple.screenIsUnlocked"] {
+            dnc.addObserver(forName: Notification.Name(name), object: nil, queue: nil) { [weak self] _ in
+                guard let self else { return }; self.queue.async { self.checkLock() }
+            }
+        }
+        NSWorkspace.shared.notificationCenter.addObserver(
+            forName: NSWorkspace.didActivateApplicationNotification, object: nil, queue: nil
+        ) { [weak self] _ in self?.poke() }
+        let t = DispatchSource.makeTimerSource(queue: queue)
+        t.schedule(deadline: .now() + 1, repeating: 1.0)
+        t.setEventHandler { [weak self] in self?.tick() }
+        t.resume()
+        timer = t
+        let l = DispatchSource.makeTimerSource(queue: queue)
+        l.schedule(deadline: .now() + 0.5, repeating: 2.0)
+        l.setEventHandler { [weak self] in self?.checkLock() }
+        l.resume()
+        lockTimer = l
+    }
+
+    /// A new viewer connected: the engine resends the lock on connect; the focus
+    /// is sent afresh.
+    func viewerConnected() {
+        queue.async {
+            self.lastFocus = nil
+            self.checkLock()
+        }
+        poke()
+    }
+
+    /// The viewer clicked (button up) or typed (key up): look again shortly
+    /// after, when the app has moved its focus.
+    func poke() {
+        queue.async {
+            guard !self.queryPending else { return }
+            self.queryPending = true
+            let wait = max(0.08, Self.minGap - (Date().timeIntervalSince1970 - self.lastQueryAt))
+            self.queue.asyncAfter(deadline: .now() + wait) {
+                self.queryPending = false
+                self.query()
+            }
+        }
+    }
+
+    // MARK: - queue
+
+    private func tick() {
+        // Focus can move with no input from the phone (a dialog opens).
+        query()
+    }
+
+    private func checkLock() {
+        let locked = Self.screenLocked()
+        let code = locked ? ScreenLock.locked : ScreenLock.unlocked
+        if code != lastLock {
+            lastLock = code
+            log("screen \(locked ? "locked" : "unlocked") — telling the viewer")
+        }
+        perform { $0?.setScreenLock(code) }
+    }
+
+    private func query() {
+        perform { [weak self] engine in
+            guard let self else { return }
+            let running = engine?.isRunning ?? false
+            self.queue.async {
+                guard running else { self.lastFocus = nil; return }
+                self.lastQueryAt = Date().timeIntervalSince1970
+                let focus = Self.currentFocus()
+                guard focus != self.lastFocus else { return }
+                self.lastFocus = focus
+                self.perform { $0?.sendTextFocus(focus) }
+            }
+        }
+    }
+
+    // MARK: - reading (no strings)
+
+    static func screenLocked() -> Bool {
+        guard let d = CGSessionCopyCurrentDictionary() as? [String: Any] else { return false }
+        if let locked = d["CGSSessionScreenIsLocked"] as? Bool, locked { return true }
+        if let onConsole = d[kCGSessionOnConsoleKey as String] as? Bool, !onConsole { return true }
+        return false
+    }
+
+    /// Roles that take typed text.
+    static let textRoles: Set<String> = [
+        kAXTextFieldRole as String, kAXTextAreaRole as String, kAXComboBoxRole as String, "AXSearchField",
+        "AXWebArea" /* only with a caret: contenteditable in a browser */,
+    ]
+
+    static func currentFocus() -> WireTextFocus {
+        let system = AXUIElementCreateSystemWide()
+        AXUIElementSetMessagingTimeout(system, 0.3)
+        guard let el = copyElement(system, kAXFocusedUIElementAttribute as String) else { return .none }
+        AXUIElementSetMessagingTimeout(el, 0.3)
+        // The role is an Apple constant naming the kind of element, never its contents.
+        let role = copyString(el, kAXRoleAttribute as String) ?? ""
+        let caret = caretFrame(el)
+        let takesText = textRoles.contains(role) && (role != "AXWebArea" || caret != nil)
+            || (caret != nil && isEditable(el))
+        guard takesText else { return .none }
+        let field = frame(el) ?? .zero
+        let c = caret ?? .zero
+        return WireTextFocus(hasText: true,
+                             fieldX: clampI(field.minX), fieldY: clampI(field.minY),
+                             fieldW: clampU(field.width), fieldH: clampU(field.height),
+                             caretX: clampI(c.minX), caretY: clampI(c.minY),
+                             caretW: clampU(max(c.width, caret == nil ? 0 : 1)), caretH: clampU(c.height))
+    }
+
+    private static func isEditable(_ el: AXUIElement) -> Bool {
+        var settable: DarwinBoolean = false
+        return AXUIElementIsAttributeSettable(el, kAXValueAttribute as CFString, &settable) == .success && settable.boolValue
+    }
+
+    private static func copyElement(_ el: AXUIElement, _ attr: String) -> AXUIElement? {
+        var v: CFTypeRef?
+        guard AXUIElementCopyAttributeValue(el, attr as CFString, &v) == .success, let v,
+              CFGetTypeID(v) == AXUIElementGetTypeID() else { return nil }
+        return (v as! AXUIElement)
+    }
+
+    private static func copyString(_ el: AXUIElement, _ attr: String) -> String? {
+        var v: CFTypeRef?
+        guard AXUIElementCopyAttributeValue(el, attr as CFString, &v) == .success else { return nil }
+        return v as? String
+    }
+
+    private static func frame(_ el: AXUIElement) -> CGRect? {
+        var p: CFTypeRef?, s: CFTypeRef?
+        guard AXUIElementCopyAttributeValue(el, kAXPositionAttribute as CFString, &p) == .success,
+              AXUIElementCopyAttributeValue(el, kAXSizeAttribute as CFString, &s) == .success,
+              let p, let s, CFGetTypeID(p) == AXValueGetTypeID(), CFGetTypeID(s) == AXValueGetTypeID() else { return nil }
+        var pt = CGPoint.zero, sz = CGSize.zero
+        guard AXValueGetValue((p as! AXValue), .cgPoint, &pt),
+              AXValueGetValue((s as! AXValue), .cgSize, &sz) else { return nil }
+        return CGRect(origin: pt, size: sz)
+    }
+
+    /// The insertion point: the bounds of the selected range (a range, not its text).
+    private static func caretFrame(_ el: AXUIElement) -> CGRect? {
+        var r: CFTypeRef?
+        guard AXUIElementCopyAttributeValue(el, kAXSelectedTextRangeAttribute as CFString, &r) == .success,
+              let r, CFGetTypeID(r) == AXValueGetTypeID() else { return nil }
+        var b: CFTypeRef?
+        guard AXUIElementCopyParameterizedAttributeValue(el, kAXBoundsForRangeParameterizedAttribute as CFString, r, &b) == .success,
+              let b, CFGetTypeID(b) == AXValueGetTypeID() else { return nil }
+        var rect = CGRect.zero
+        guard AXValueGetValue((b as! AXValue), .cgRect, &rect),
+              rect.height > 0, rect.height < 400 else { return nil }
+        return rect
+    }
+
+    private static func clampI(_ v: CGFloat) -> Int32 { Int32(max(-1_000_000, min(1_000_000, v.rounded()))) }
+    private static func clampU(_ v: CGFloat) -> UInt16 { UInt16(max(0, min(65_535, v.rounded()))) }
+}
