+    /// Duo Screens build (picture size): the next `--picture-steps` change, in session (re-HELLO, no
+    /// reconnect), as the Host's `restartCapture(inSession: true)`.
+    private func runPictureSteps() {
+        guard stepsDone < options.pictureSteps.count, let settledAt else { return }
+        let step = options.pictureSteps[stepsDone]
+        guard Date().timeIntervalSince(settledAt) >= step.at else { return }
+        stepsDone += 1
+        picture = (step.w, step.h) // at the screen's own size too, so the log reads the same at every size
+        Scene.log("picture → \(step.w)×\(step.h) (screen stays \(scene.width)×\(scene.height))")
+        let seed = engine?.currentFrameSeq ?? 1
+        if let old = engine { old.onFailed = nil }
+        let previous = engine
+        makeEngine(startFrameSeq: seed)
+        if let previous { engine?.continueSession(from: previous) }
+    }
+
+    /// Duo Screens build (picture size): the screen scaled into the picture's pixels.
+    private func scaledPicture(_ pic: (w: Int, h: Int)) {
+        if picturePixels.count != pic.w * pic.h * 4 { picturePixels = [UInt8](repeating: 0, count: pic.w * pic.h * 4) }
+        let space = CGColorSpace(name: CGColorSpace.sRGB)!
+        let info = CGImageAlphaInfo.premultipliedFirst.rawValue | CGBitmapInfo.byteOrder32Little.rawValue
+        let sw = scene.width, sh = scene.height
+        let image: CGImage? = scene.pixels.withUnsafeBytes { raw in
+            guard let provider = CGDataProvider(data: Data(raw) as CFData) else { return nil }
+            return CGImage(width: sw, height: sh, bitsPerComponent: 8, bitsPerPixel: 32, bytesPerRow: sw * 4,
+                           space: space, bitmapInfo: CGBitmapInfo(rawValue: info), provider: provider,
+                           decode: nil, shouldInterpolate: true, intent: .defaultIntent)
+        }
+        guard let image else { return }
+        picturePixels.withUnsafeMutableBytes { buf in
+            guard let ctx = CGContext(data: buf.baseAddress, width: pic.w, height: pic.h, bitsPerComponent: 8,
+                                      bytesPerRow: pic.w * 4, space: space, bitmapInfo: info) else { return }
+            ctx.interpolationQuality = .medium
+            ctx.draw(image, in: CGRect(x: 0, y: 0, width: pic.w, height: pic.h))
+        }
+    }
