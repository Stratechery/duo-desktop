+    /// Duo Desktop build: where the next typing lands when the element gives no caret: the end of its text, by
+    /// character count (`AXNumberOfCharacters`) and character bounds (`AXBoundsForRange`), else the last visible
+    /// character (`AXVisibleCharacterRange`). Terminal pads a fresh window with empty rows below the prompt; an
+    /// empty row's single character starts at the element's left edge and spans most of its width, so those are
+    /// stepped over (at most `maxEmptyRows`) to the row that ends the text: the prompt. Proof on agents' Mac: a fresh
+    /// window's last character was an empty bottom row (x 10, 840 wide of 860); a full one's started at the prompt's
+    /// end (x 262). Ranges and bounds only; the text itself is never read. Returned 1 point wide, as a caret.
+    static func endOfTextFrame(_ el: AXUIElement) -> CGRect? {
+        var n: CFTypeRef?
+        var last: Int?
+        if AXUIElementCopyAttributeValue(el, kAXNumberOfCharactersAttribute as CFString, &n) == .success,
+           let count = n as? Int, count > 0 {
+            last = count - 1
+        } else {
+            var v: CFTypeRef?
+            if AXUIElementCopyAttributeValue(el, kAXVisibleCharacterRangeAttribute as CFString, &v) == .success,
+               let v, CFGetTypeID(v) == AXValueGetTypeID() {
+                var visible = CFRange()
+                if AXValueGetValue((v as! AXValue), .cfRange, &visible), visible.length > 0 {
+                    last = visible.location + visible.length - 1
+                }
+            }
+        }
+        guard let last, var rect = bounds(el, CFRange(location: last, length: 1)) else { return nil }
+        if let field = frame(el), field.width > 0 {
+            var i = last
+            func emptyRow(_ r: CGRect) -> Bool { r.minX <= field.minX + 16 && r.width >= field.width * 0.8 }
+            while emptyRow(rect), i > 0, last - i < maxEmptyRows, let prev = bounds(el, CFRange(location: i - 1, length: 1)) {
+                i -= 1
+                rect = prev
+            }
+        }
+        return CGRect(x: rect.minX, y: rect.minY, width: 1, height: rect.height)
+    }
+
+    /// Empty rows stepped over looking for the end of the text (a tall window has about 60).
+    static let maxEmptyRows = 200
+
+    private static func bounds(_ el: AXUIElement, _ range: CFRange) -> CGRect? {
+        var range = range
+        guard let r = AXValueCreate(.cfRange, &range) else { return nil }
+        var b: CFTypeRef?
+        guard AXUIElementCopyParameterizedAttributeValue(el, kAXBoundsForRangeParameterizedAttribute as CFString, r, &b) == .success,
+              let b, CFGetTypeID(b) == AXValueGetTypeID() else { return nil }
+        var rect = CGRect.zero
+        guard AXValueGetValue((b as! AXValue), .cgRect, &rect), rect.height > 0, rect.height < 400 else { return nil }
+        return rect
+    }
