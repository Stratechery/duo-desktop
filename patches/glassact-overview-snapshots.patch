diff --git a/Tests/SessionTests/RealHostTerminalEndProofTests.swift b/Tests/SessionTests/RealHostTerminalEndProofTests.swift
new file mode 100644
index 0000000..431ae34
--- /dev/null
+++ b/Tests/SessionTests/RealHostTerminalEndProofTests.swift
@@ -0,0 +1,85 @@
+// Duo Desktop build (overview snapshots order, Terminal aim): proof on this Mac's own Host (127.0.0.1) that a text
+// element with no caret reports the END OF ITS TEXT as the insertion point (Terminal's prompt), in a fresh window and
+// after output fills it. Keys go through the Host (kind 5/6), so no permission beyond the Host's own is used.
+// Runs only with GLASSACT_REALHOST_PORT set and the proof viewer's key on the Host's approved list.
+#if os(macOS)
+import AppKit
+import CoreGraphics
+import Foundation
+import GlassActCore
+@testable import GlassActSession
+import GlassActTransport
+import GlassActWire
+import XCTest
+
+final class RealHostTerminalEndProofTests: XCTestCase {
+    func spin(_ seconds: Double, until done: () -> Bool = { false }) {
+        let end = Date().addingTimeInterval(seconds)
+        while Date() < end, !done() { RunLoop.current.run(until: Date().addingTimeInterval(0.05)) }
+    }
+
+    func describe(_ f: WireTextFocus?) -> String {
+        guard let f else { return "nothing received" }
+        guard f.hasText else { return "none (not a text place)" }
+        return "text: field \(f.fieldX),\(f.fieldY) \(f.fieldW)x\(f.fieldH); caret \(f.caretX),\(f.caretY) \(f.caretW)x\(f.caretH)"
+    }
+
+    func terminalWindows() -> [CGRect] {
+        let list = CGWindowListCopyWindowInfo([.optionOnScreenOnly, .excludeDesktopElements], kCGNullWindowID) as? [[String: Any]] ?? []
+        return list.filter { ($0[kCGWindowOwnerName as String] as? String) == "Terminal" && ($0[kCGWindowLayer as String] as? Int) == 0 }
+            .compactMap { ($0[kCGWindowBounds as String] as? NSDictionary).flatMap { CGRect(dictionaryRepresentation: $0) } }
+    }
+
+    @MainActor
+    func testTerminalCaretIsTheEndOfItsText() throws {
+        guard let portText = ProcessInfo.processInfo.environment["GLASSACT_REALHOST_PORT"],
+              let port = UInt16(portText) else { throw XCTSkip("no real host (GLASSACT_REALHOST_PORT)") }
+        let dir = URL(fileURLWithPath: ProcessInfo.processInfo.environment["GLASSACT_PROOF_DIR"] ?? NSTemporaryDirectory())
+        let id = try QUICIdentity.loadOrCreate(directory: dir, name: "proof-viewer-identity", commonName: "duo-proof")
+        print("proof: viewer fingerprint \(try QUICIdentity.fingerprint(of: id))")
+        let session = ViewerSession(host: "127.0.0.1", port: port, fingerprint: "", identity: id,
+                                    options: .init(cursorMetadata: true, video: false, deviceName: "duo-proof"))
+        let lock = NSLock()
+        var focuses: [WireTextFocus] = []
+        session.engine.onTextFocus = { f in lock.lock(); focuses.append(f); lock.unlock() }
+        func latest() -> WireTextFocus? { lock.lock(); defer { lock.unlock() }; return focuses.last }
+        let main = CGDisplayBounds(CGMainDisplayID())
+        session.setRequestedGeometry(mode: 2, widthPoints: Int(main.width), heightPoints: Int(main.height), scale: 1)
+        session.start()
+        spin(15) { session.configuredGrid() != nil }
+        _ = try XCTUnwrap(session.configuredGrid(), "connected")
+        spin(2)
+
+        func key(_ code: Int, _ flags: Int = 0) {
+            session.sendInput(kind: 5, x: code, y: 0, a: flags, b: 0); spin(0.03)
+            session.sendInput(kind: 6, x: code, y: 0, a: flags, b: 0); spin(0.03)
+        }
+        let codes: [Character: Int] = ["s": 1, "e": 14, "q": 12, " ": 49, "1": 18, "3": 20, "0": 29, "c": 8, "l": 37,
+                                       "a": 0, "r": 15]
+        func type(_ text: String) { for ch in text { key(codes[ch]!) }; key(36) }
+        let cmd = 0x100000
+
+        let url = try XCTUnwrap(NSWorkspace.shared.urlForApplication(withBundleIdentifier: "com.apple.Terminal"))
+        NSWorkspace.shared.openApplication(at: url, configuration: NSWorkspace.OpenConfiguration())
+        spin(2)
+        key(45, cmd) // ⌘N: a fresh window
+        spin(3)
+        let fresh = latest()
+        print("proof: Terminal windows \(terminalWindows())")
+        print("proof: fresh window: \(describe(fresh))")
+        type("seq 1 300")
+        spin(3)
+        let full = latest()
+        print("proof: after seq 1 300 (window full): \(describe(full))")
+        key(13, cmd) // ⌘W: close the proof window (idle shell)
+        spin(1)
+        session.stop()
+        spin(1)
+        XCTAssertEqual(fresh?.hasText, true)
+        XCTAssertEqual(full?.hasText, true)
+        if let fresh, let full, fresh.caretH > 0, full.caretH > 0 {
