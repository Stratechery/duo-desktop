@@ -0,0 +1,47 @@
+// Duo Screens build (multi-screen): DISPLAY_LIST / DISPLAY_SELECT on the wire.
+import XCTest
+@testable import GlassActWire
+
+final class DisplayMessagesTests: XCTestCase {
+    func testDisplayListRoundTrips() throws {
+        let list = ControlMessage.displayList(displays: [
+            WireDisplay(displayID: 1, name: "Main", x: 0, y: 0, width: 1920, height: 1080,
+                        pixelsPerPoint100: 200, isMain: true, isShown: true),
+            WireDisplay(displayID: 3, name: "Portrait ✓", x: 1960, y: -420, width: 1080, height: 1920,
+                        rotation: 90, isMain: false, isShown: false,
+                        thumbFormat: 1, thumbWidth: 112, thumbHeight: 200, thumb: [1, 2, 3, 4]),
+        ])
+        var d = ControlDeframer()
+        d.append(list.encoded())
+        XCTAssertEqual(d.next(), .message(list))
+    }
+
+    func testDisplaySelectRoundTripsWithNegativePoint() {
+        let sel = ControlMessage.displaySelect(displayID: 2, placePointer: true, pointerX: -1, pointerY: -400)
+        XCTAssertEqual(sel.tlvType, 0x61)
+        var d = ControlDeframer()
+        d.append(sel.encoded())
+        XCTAssertEqual(d.next(), .message(sel))
+    }
+
+    func testNewTypesAreKnownAndOldTypesUnchanged() {
+        XCTAssertTrue(ControlMessage.isKnownType(0x60))
+        XCTAssertTrue(ControlMessage.isKnownType(0x61))
+        XCTAssertFalse(ControlMessage.isKnownType(0x5F))
+        XCTAssertEqual(WireCaps.displayList, 1 << 31)
+    }
+
+    func testDisplaySelectedRoundTrips() throws {
+        let r = WireDisplaySelection(requestedID: 4, status: .ok, displayID: 4, x: 0, y: -1080, width: 1920, height: 1080,
+                                     pictureWidth: 960, pictureHeight: 540, pointerPlaced: true, pointerX: 100, pointerY: -500)
+        let msg = ControlMessage.displaySelected(r)
+        XCTAssertEqual(msg.tlvType, 0x62)
+        let refused = ControlMessage.displaySelected(WireDisplaySelection(requestedID: 9, status: .notOffered, displayID: 1))
+        var d = ControlDeframer()
+        d.append(msg.encoded())
+        d.append(refused.encoded())
+        XCTAssertEqual(d.next(), .message(msg))
+        XCTAssertEqual(d.next(), .message(refused))
+        XCTAssertTrue(ControlMessage.isKnownType(0x62))
+    }
+}
