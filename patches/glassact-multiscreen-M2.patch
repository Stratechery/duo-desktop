diff --git a/Sources/GlassActCore/DisplayChoice.swift b/Sources/GlassActCore/DisplayChoice.swift
new file mode 100644
index 0000000..b44b701
--- /dev/null
+++ b/Sources/GlassActCore/DisplayChoice.swift
@@ -0,0 +1,60 @@
+// Duo Screens build (multi-screen): the Host's screen-choice rules, kept pure
+// so they are unit-tested (Tests/GlassActCoreTests/DisplayChoiceTests.swift)
+// and shared by the Host and the test host.
+
+public enum DisplayChoice {
+    /// A screen in global points (the main screen's top-left is 0,0).
+    public struct Rect: Equatable, Sendable {
+        public var x: Double, y: Double, width: Double, height: Double
+        public init(x: Double, y: Double, width: Double, height: Double) {
+            self.x = x; self.y = y; self.width = width; self.height = height
+        }
+        public func contains(_ px: Double, _ py: Double) -> Bool {
+            px >= x && py >= y && px < x + width && py < y + height
+        }
+    }
+
+    /// Which screen to share. The viewer's pick when the host offers it;
+    /// otherwise the main screen — never "the first one listed". `nil`
+    /// (nothing picked, e.g. an older app) is the main screen, as before.
+    public static func screenToShare(requested: UInt32?, offered: [UInt32], main: UInt32) -> UInt32 {
+        if let requested, requested != 0, offered.contains(requested) { return requested }
+        return main
+    }
+
+    /// Where the host puts the pointer on a switch: the asked-for point
+    /// clamped inside `screen` (one point in from each edge); no point asked
+    /// = the middle of the screen.
+    public static func pointerPlacement(asked: (x: Double, y: Double)?, on screen: Rect) -> (x: Double, y: Double) {
+        guard let asked else { return (screen.x + screen.width / 2, screen.y + screen.height / 2) }
+        let inset = 1.0
+        let x = min(max(asked.x, screen.x + min(inset, screen.width / 2)),
+                    screen.x + screen.width - min(inset, screen.width / 2))
+        let y = min(max(asked.y, screen.y + min(inset, screen.height / 2)),
+                    screen.y + screen.height - min(inset, screen.height / 2))
+        return (x, y)
+    }
+
+    /// Every move and click stays on the shown screen: a canvas position is
+    /// clamped to the picture (the last pixel), so nothing lands on a
+    /// neighbour. A deliberate crossing is a DISPLAY_SELECT, never a move.
+    public static func clampToCanvas(x: Int, y: Int, width: Int, height: Int) -> (x: Int, y: Int) {
+        (min(max(x, 0), max(width - 1, 0)), min(max(y, 0), max(height - 1, 0)))
+    }
+
+    /// Geometry modes the host refuses for every viewer: 1 (Client
+    /// Resolution — changes the Mac's resolution) and 4 (virtual display —
+    /// mirrors the real screens) become 2 (Scale): the Host never
+    /// changes the resolution on the Mac.
+    public static func allowedGeometryMode(_ mode: Int) -> Int {
+        (mode == 1 || mode == 4) ? 2 : mode
+    }
+
+    /// Scale: the screen's pixels aspect-fitted into the request, never
+    /// enlarged past the screen's own pixels, even sides.
+    public static func scaledSize(screen: (w: Int, h: Int), request: (w: Int, h: Int)) -> (w: Int, h: Int) {
+        guard screen.w > 0, screen.h > 0, request.w > 0, request.h > 0 else { return screen }
+        let f = min(Double(request.w) / Double(screen.w), Double(request.h) / Double(screen.h), 1)
+        return (max(2, Int(Double(screen.w) * f) & ~1), max(2, Int(Double(screen.h) * f) & ~1))
+    }
+}
