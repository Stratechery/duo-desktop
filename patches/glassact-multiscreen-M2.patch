+final class DisplaySwitchLiveTests: XCTestCase {
+    @MainActor
+    func testFourScreensThenSwitchToScreen3OnSameConnection() throws {
+        guard let portText = ProcessInfo.processInfo.environment["GLASSACT_TESTHOST_PORT"],
+              let port = UInt16(portText) else { throw XCTSkip("no test host (GLASSACT_TESTHOST_PORT)") }
+        let dir = FileManager.default.temporaryDirectory.appendingPathComponent("duo-multiscreen-test", isDirectory: true)
+        try FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)
+        let identity = try QUICIdentity.loadOrCreate(directory: dir, name: "viewer-identity", commonName: "duo-multiscreen-test")
+        let controller = ViewerController(host: "127.0.0.1", port: port, fingerprint: "", identity: identity,
+                                          deviceName: "duo-multiscreen-test")
+        var sizes: [(Int, Int)] = []
+        var lists: [[WireDisplay]] = []
+        var failures = 0
+        var results: [WireDisplaySelection] = []
+        controller.onDisplaySelected = { results.append($0) }
+        var resizedAt: Date?
+        controller.onGeometryChanged = { w, h in sizes.append((w, h)); resizedAt = resizedAt ?? Date() }
+        controller.onDisplayList = { lists.append($0) }
+        controller.onConnectionFailed = { failures += 1 }
+        // As Duo Desktop asks: Scale into 1920 x 1080 (SessionModel), so screens fit the request.
+        controller.setRequestedGeometry(mode: 2, widthPoints: 1920, heightPoints: 1080, scale: 1)
+        controller.start()
+        defer { controller.stop() }
+
+        func spin(_ seconds: Double, until done: () -> Bool) {
+            let end = Date().addingTimeInterval(seconds)
+            while !done(), Date() < end { RunLoop.main.run(until: Date().addingTimeInterval(0.02)) }
+        }
+        spin(10) { controller.hostSupportsDisplayList() }
+        XCTAssertTrue(controller.hostSupportsDisplayList(), "host advertises the screen list")
+        spin(5) { controller.configuredGrid()?.width == 1920 }
+        let startSize = (controller.configuredGrid()?.width ?? 0, controller.configuredGrid()?.height ?? 0)
+        XCTAssertTrue(startSize == (1920, 1080), "starts on Main")
+
+        controller.selectDisplay(0)
+        spin(5) { !lists.isEmpty }
+        let first = try XCTUnwrap(lists.first, "screen list arrived")
+        XCTAssertEqual(first.count, 4)
+        let main = try XCTUnwrap(first.first { $0.displayID == 1 }), top = try XCTUnwrap(first.first { $0.displayID == 4 })
+        XCTAssertTrue(main.width == top.width && main.height == top.height, "screens 1 and 4 are the same size")
+        XCTAssertEqual(first.filter(\.isMain).map(\.displayID), [1])
+        XCTAssertEqual(first.filter(\.isShown).map(\.displayID), [1])
+        XCTAssertTrue(first.allSatisfy { $0.thumbFormat != 0 && !$0.thumb.isEmpty }, "each has a small picture")
+        print("duo-multiscreen: list " + first.map { "\($0.displayID) \($0.name) \($0.width)x\($0.height) at \($0.x),\($0.y)" }.joined(separator: "; "))
+
+        let asked = Date()
+        controller.selectDisplay(3, pointerAt: (x: 2500, y: 0))
+        spin(5) { !sizes.isEmpty && lists.count >= 2 }
+        let ms = (resizedAt ?? Date()).timeIntervalSince(asked) * 1000
+        let size = try XCTUnwrap(sizes.last, "picture changed size on the same connection")
+        XCTAssertTrue(size == (606, 1080), "portrait screen 3 fitted into 1920 x 1080, got \(size)")
+        XCTAssertEqual(lists.last?.filter(\.isShown).map(\.displayID), [3])
+        XCTAssertEqual(failures, 0, "no reconnect")
+        print(String(format: "duo-multiscreen: start %dx%d, screen 3 picture %dx%d after %.0f ms (viewer side)",
+                     startSize.0, startSize.1, size.0, size.1, ms))
+        spin(5) { results.count >= 1 }
+        XCTAssertEqual(results.first?.displayID, 3)
+        XCTAssertEqual(results.first?.status, .ok)
+
+        // Reviewer P1: two EQUAL-sized screens. Back to Main, then to Top (same size): no geometry
+        // callback can tell these apart; only DISPLAY_SELECTED does. Sent back to back, so the
+        // second is serialized behind the first.
+        controller.selectDisplay(1)
+        controller.selectDisplay(4, pointerAt: (x: 100, y: -500))
+        spin(0.05) { false }
+        XCTAssertTrue(controller.displaySelectPending(), "a choice is waiting for its answer")
+        let sizesBefore = sizes.count
+        spin(5) { results.count >= 3 }
+        XCTAssertEqual(results.count, 3)
+        let toMain = results[1], toTop = results[2]
+        XCTAssertEqual(toMain.requestedID, 1); XCTAssertEqual(toMain.displayID, 1); XCTAssertEqual(toMain.status, .ok)
+        XCTAssertEqual(toTop.requestedID, 4); XCTAssertEqual(toTop.displayID, 4); XCTAssertEqual(toTop.status, .ok)
+        XCTAssertEqual(toTop.y, -1080); XCTAssertEqual(toTop.width, 1920); XCTAssertEqual(toTop.height, 1080)
+        XCTAssertEqual(toTop.pictureWidth, 1920); XCTAssertEqual(toTop.pictureHeight, 1080)
+        XCTAssertTrue(toTop.pointerPlaced); XCTAssertEqual(toTop.pointerX, 100); XCTAssertEqual(toTop.pointerY, -500)
+        XCTAssertFalse(controller.displaySelectPending())
+        // Main → Top changed no picture size; the app still knows it is on Top, and carries on there:
+        spin(5) { lists.last?.filter(\.isShown).map(\.displayID) == [4] }
+        XCTAssertEqual(lists.last?.filter(\.isShown).map(\.displayID), [4])
+        XCTAssertTrue(controller.configuredGrid()?.width == 1920 && controller.configuredGrid()?.height == 1080)
+        print("duo-multiscreen: equal-size switch 1 → 4: geometry callbacks during it \(sizes.count - sizesBefore) "
+              + "(size \(sizes.last.map { "\($0.0)x\($0.1)" } ?? "-")); answer: shown \(toTop.displayID) at "
+              + "\(toTop.x),\(toTop.y) \(toTop.width)x\(toTop.height), picture \(toTop.pictureWidth)x\(toTop.pictureHeight), "
+              + "pointer \(toTop.pointerX),\(toTop.pointerY)")
+        // Carries on on Top: a click at the picture's middle (the test host logs it after "screen → 4").
+        controller.sendInput(kind: 1, x: 960, y: 540, a: 0, b: 0)
+        controller.sendInput(kind: 2, x: 960, y: 540, a: 1, b: 0)
+        controller.sendInput(kind: 3, x: 960, y: 540, a: 1, b: 0)
+        var picture = false
+        controller.hasPicture { picture = $0 }
+        spin(3) { picture }
+        XCTAssertTrue(picture, "a picture after the switch")
+
+        // A screen that is not offered: refused, nothing changes.
+        controller.selectDisplay(99)
+        spin(5) { results.count >= 4 }
+        XCTAssertEqual(results.last?.requestedID, 99)
+        XCTAssertEqual(results.last?.status, .notOffered)
+        XCTAssertEqual(results.last?.displayID, 4, "still on Top")
+        XCTAssertEqual(failures, 0, "no reconnect")
+        print("duo-multiscreen: answers " + results.map { "\($0.requestedID)→\($0.displayID) \($0.status)" }.joined(separator: ", "))
+    }
+}
