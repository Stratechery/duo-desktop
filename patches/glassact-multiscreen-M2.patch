diff --git a/Tests/CoreTests/DisplayChoiceTests.swift b/Tests/CoreTests/DisplayChoiceTests.swift
new file mode 100644
index 0000000..0cdbcb5
--- /dev/null
+++ b/Tests/CoreTests/DisplayChoiceTests.swift
@@ -0,0 +1,44 @@
+// Duo Screens build (multi-screen): the Host's screen-choice rules.
+import XCTest
+@testable import GlassActCore
+
+final class DisplayChoiceTests: XCTestCase {
+    func testOlderAppGetsMain() {
+        // An app that never sends DISPLAY_SELECT (builds up to 24): main, as today.
+        XCTAssertEqual(DisplayChoice.screenToShare(requested: nil, offered: [5, 3, 9], main: 3), 3)
+    }
+    func testPickedScreenWhenOffered() {
+        XCTAssertEqual(DisplayChoice.screenToShare(requested: 9, offered: [5, 3, 9], main: 3), 9)
+    }
+    func testUnknownOrGoneScreenFallsBackToMainNeverFirstListed() {
+        XCTAssertEqual(DisplayChoice.screenToShare(requested: 7, offered: [5, 3, 9], main: 3), 3)
+        XCTAssertEqual(DisplayChoice.screenToShare(requested: 0, offered: [5, 3, 9], main: 3), 3)
+    }
+    func testPointerPlacedInsideTheNewScreen() {
+        let left = DisplayChoice.Rect(x: -1680, y: 30, width: 1680, height: 1050)
+        let p = DisplayChoice.pointerPlacement(asked: (x: 5, y: 500), on: left) // pushed off Main's left edge
+        XCTAssertEqual(p.x, -1)
+        XCTAssertEqual(p.y, 500)
+        let mid = DisplayChoice.pointerPlacement(asked: nil, on: left)
+        XCTAssertEqual(mid.x, -840)
+        XCTAssertEqual(mid.y, 555)
+        let low = DisplayChoice.pointerPlacement(asked: (x: -100, y: 5000), on: left)
+        XCTAssertEqual(low.y, 30 + 1050 - 1)
+    }
+    func testInputClampedToShownScreen() {
+        XCTAssertTrue(DisplayChoice.clampToCanvas(x: 3840, y: 500, width: 1920, height: 1080) == (1919, 500))
+        XCTAssertTrue(DisplayChoice.clampToCanvas(x: 10, y: 1080, width: 1920, height: 1080) == (10, 1079))
+    }
+    func testResolutionAndVirtualDisplayModesRefused() {
+        XCTAssertEqual(DisplayChoice.allowedGeometryMode(1), 2)
+        XCTAssertEqual(DisplayChoice.allowedGeometryMode(4), 2)
+        XCTAssertEqual(DisplayChoice.allowedGeometryMode(2), 2)
+        XCTAssertEqual(DisplayChoice.allowedGeometryMode(3), 3)
+        XCTAssertEqual(DisplayChoice.allowedGeometryMode(0), 0)
+    }
+    func testScaleFitsShapes() {
+        XCTAssertTrue(DisplayChoice.scaledSize(screen: (3440, 1440), request: (1920, 1080)) == (1920, 802))
+        XCTAssertTrue(DisplayChoice.scaledSize(screen: (1080, 1920), request: (1920, 1080)) == (606, 1080))
+        XCTAssertTrue(DisplayChoice.scaledSize(screen: (1280, 720), request: (1920, 1080)) == (1280, 720))
+    }
+}
