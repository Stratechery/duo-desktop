+// Duo Screens build (multi-screen), M3 proof on this Mac's two real screens: this Mac's own
+// Glass Act Host (127.0.0.1:4433), a tiles-only viewer (every pixel exact, so the picture can be
+// compared with a screenshot of the display taken at the same moment). Skipped unless
+// GLASSACT_REALHOST_PORT is set. GLASSACT_PROOF_DIR: the viewer key and the evidence pictures.
+import XCTest
+import CoreGraphics
+import ImageIO
+import UniformTypeIdentifiers
+import GlassActCore
+@testable import GlassActSession
+import GlassActTransport
+import GlassActWire
+
+final class RealHostTwoScreensProofTests: XCTestCase {
+    var dir: URL!
+
+    func identity() throws -> SecIdentity {
+        let path = ProcessInfo.processInfo.environment["GLASSACT_PROOF_DIR"] ?? NSTemporaryDirectory()
+        dir = URL(fileURLWithPath: path, isDirectory: true)
+        try FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)
+        let id = try QUICIdentity.loadOrCreate(directory: dir, name: "proof-viewer-identity", commonName: "duo-proof")
+        print("proof: viewer fingerprint \(try QUICIdentity.fingerprint(of: id))")
+        return id
+    }
+
+    @MainActor
+    func spin(_ seconds: Double, until done: () -> Bool) {
+        let end = Date().addingTimeInterval(seconds)
+        while !done(), Date() < end { RunLoop.main.run(until: Date().addingTimeInterval(0.02)) }
+    }
+
+    /// `screencapture -D n` (1 = main), as a CGImage.
+    func screenshot(display n: Int, name: String) throws -> CGImage {
+        let url = dir.appendingPathComponent(name)
+        let p = Process()
+        p.executableURL = URL(fileURLWithPath: "/usr/sbin/screencapture")
+        p.arguments = ["-x", "-D", String(n), url.path]
+        try p.run(); p.waitUntilExit()
+        let src = try XCTUnwrap(CGImageSourceCreateWithURL(url as CFURL, nil))
+        return try XCTUnwrap(CGImageSourceCreateImageAtIndex(src, 0, nil))
+    }
+
+    func save(_ image: CGImage, _ name: String) {
+        let url = dir.appendingPathComponent(name)
+        guard let dst = CGImageDestinationCreateWithURL(url as CFURL, UTType.png.identifier as CFString, 1, nil) else { return }
+        CGImageDestinationAddImage(dst, image, nil)
+        CGImageDestinationFinalize(dst)
+    }
+
+    /// Mean absolute grey difference (0–255) of two pictures shrunk to 96 × 54.
+    func difference(_ a: CGImage, _ b: CGImage) -> Double {
+        func grey(_ i: CGImage) -> [UInt8] {
+            var px = [UInt8](repeating: 0, count: 96 * 54)
+            px.withUnsafeMutableBytes { buf in
+                let ctx = CGContext(data: buf.baseAddress, width: 96, height: 54, bitsPerComponent: 8, bytesPerRow: 96,
+                                    space: CGColorSpaceCreateDeviceGray(), bitmapInfo: CGImageAlphaInfo.none.rawValue)!
+                ctx.interpolationQuality = .medium
+                ctx.draw(i, in: CGRect(x: 0, y: 0, width: 96, height: 54))
+            }
+            return px
+        }
+        let ga = grey(a), gb = grey(b)
+        return Double(zip(ga, gb).map { abs(Int($0) - Int($1)) }.reduce(0, +)) / Double(ga.count)
+    }
+
+    func picture(_ session: ViewerSession) -> CGImage? {
+        session.queue.sync { ScreenFrame.capture(session.engine) }?.image()
+    }
+
+    func pointer() -> CGPoint { CGEvent(source: nil)?.location ?? .zero }
+
+    @MainActor
+    func testTwoRealScreens() throws {
+        let id = try identity()
+        guard let portText = ProcessInfo.processInfo.environment["GLASSACT_REALHOST_PORT"],
+              let port = UInt16(portText) else { throw XCTSkip("no real host (GLASSACT_REALHOST_PORT)") }
+
+        // 1. An old-style connection: no screen choice at all → the main screen.
+        do {
+            let old = ViewerSession(host: "127.0.0.1", port: port, fingerprint: "", identity: id,
+                                    options: .init(cursorMetadata: true, video: false, deviceName: "duo-proof-old"))
+            old.setRequestedGeometry(mode: 2, widthPoints: 1920, heightPoints: 1200, scale: 1)
+            old.start()
+            var has = false
+            spin(15) { old.hasPicture { has = $0 }; return has && old.configuredGrid() != nil }
+            spin(3) { false } // let the tiles settle
+            let grid = try XCTUnwrap(old.configuredGrid(), "old-style session got a picture")
+            let pic = try XCTUnwrap(picture(old))
+            let shotMain = try screenshot(display: 1, name: "old-style-main-screenshot.png")
+            let shot2 = try screenshot(display: 2, name: "old-style-second-screenshot.png")
+            save(pic, "old-style-viewer-picture.png")
+            let dMain = difference(pic, shotMain), d2 = difference(pic, shot2)
+            print(String(format: "proof: old-style (no choice): picture %dx%d; differs from main screenshot by %.1f, from second by %.1f",
+                         grid.width, grid.height, dMain, d2))
+            XCTAssertLessThan(dMain, d2, "an old-style session shows the main screen")
+            old.stop()
+            spin(2) { false }
+        }
+
+        // 2. A new-style connection.
+        let session = ViewerSession(host: "127.0.0.1", port: port, fingerprint: "", identity: id,
+                                    options: .init(cursorMetadata: true, video: false, deviceName: "duo-proof"))
+        var lists: [[WireDisplay]] = []
+        var results: [WireDisplaySelection] = []
+        session.onDisplayList = { lists.append($0) }
+        session.onDisplaySelected = { results.append($0) }
+        session.setRequestedGeometry(mode: 2, widthPoints: 1920, heightPoints: 1200, scale: 1)
+        session.start()
+        spin(15) { session.hostSupportsDisplayList() && session.configuredGrid() != nil }
+        XCTAssertTrue(session.hostSupportsDisplayList(), "the Host offers the screen list")
+        XCTAssertFalse(session.hostSupportsVirtualDisplay(), "the Host no longer offers a virtual display")
+
+        session.selectDisplay(0)
+        spin(10) { !lists.isEmpty }
+        let list = try XCTUnwrap(lists.first, "screen list arrived")
+        var ids = [CGDirectDisplayID](repeating: 0, count: 8); var n: UInt32 = 0
+        CGGetActiveDisplayList(8, &ids, &n)
+        print("proof: list " + list.map { "\($0.displayID) \"\($0.name)\" \($0.width)x\($0.height) at \($0.x),\($0.y) ppp \($0.pixelsPerPoint100)\($0.isMain ? " main" : "")\($0.isShown ? " shown" : "") [picture \($0.thumbWidth)x\($0.thumbHeight)]" }.joined(separator: "; "))
+        print("proof: macOS says " + ids.prefix(Int(n)).map { let b = CGDisplayBounds($0); return "\($0) \(Int(b.width))x\(Int(b.height)) at \(Int(b.minX)),\(Int(b.minY))\(CGDisplayIsMain($0) != 0 ? " main" : "")" }.joined(separator: "; "))
+        XCTAssertEqual(list.count, Int(n), "every screen offered")
+        for d in list {
+            let b = CGDisplayBounds(d.displayID)
+            XCTAssertEqual(Int(d.x), Int(b.minX)); XCTAssertEqual(Int(d.y), Int(b.minY))
+            XCTAssertEqual(Int(d.width), Int(b.width)); XCTAssertEqual(Int(d.height), Int(b.height))
+        }
+        let main = try XCTUnwrap(list.first { $0.isMain }), second = try XCTUnwrap(list.first { !$0.isMain })
+        XCTAssertTrue(main.isShown)
+
+        // 3. Choose the second screen.
+        session.selectDisplay(second.displayID)
+        spin(10) { !results.isEmpty }
+        let r = try XCTUnwrap(results.first, "an answer")
+        print("proof: choose \(second.displayID): answer \(r.status) shown \(r.displayID) at \(r.x),\(r.y) \(r.width)x\(r.height), picture \(r.pictureWidth)x\(r.pictureHeight), pointer \(r.pointerX),\(r.pointerY); pointer now \(pointer())")
+        XCTAssertEqual(r.status, .ok); XCTAssertEqual(r.displayID, second.displayID)
+        XCTAssertEqual(Int(r.x), Int(second.x)); XCTAssertEqual(Int(r.width), Int(second.width))
+        XCTAssertTrue(CGDisplayBounds(second.displayID).contains(pointer()), "the Host put the pointer on the second screen")
+        spin(10) { session.configuredGrid()?.width == Int(r.pictureWidth) && session.configuredGrid()?.height == Int(r.pictureHeight) }
+        spin(4) { false }
+        let pic2 = try XCTUnwrap(picture(session))
+        let s2 = try screenshot(display: 2, name: "second-screenshot.png")
+        let s1 = try screenshot(display: 1, name: "second-chosen-main-screenshot.png")
+        save(pic2, "second-viewer-picture.png")
+        let d2 = difference(pic2, s2), d1 = difference(pic2, s1)
+        print(String(format: "proof: on second: picture %dx%d differs from the second screen's screenshot by %.1f, from main's by %.1f",
+                     pic2.width, pic2.height, d2, d1))
+        XCTAssertLessThan(d2, d1, "the picture is the second screen's")
+        XCTAssertLessThan(d2, 12, "the picture matches the second screen")
+
+        // 4. A move and a move far past the picture's edge while on the second screen: both stay on it.
+        session.sendInput(kind: 1, x: 200, y: 150, a: 0, b: 0)
+        spin(0.6) { false }
+        let p1 = pointer()
+        session.sendInput(kind: 1, x: 99_999, y: 150, a: 0, b: 0)
+        spin(0.6) { false }
+        let p2 = pointer()
+        let b2 = CGDisplayBounds(second.displayID)
+        print("proof: move to picture 200,150 → pointer \(p1); move to picture 99999,150 → pointer \(p2); second screen \(b2)")
+        XCTAssertTrue(b2.contains(p1)); XCTAssertTrue(b2.contains(p2), "a move past the edge stays on the shown screen")
+
+        // 5. The forbidden modes, asked on the second screen: refused in the Host (log), the handshake finishes.
+        session.requestResize(mode: 1, widthPoints: 1280, heightPoints: 800, scale: 1)
+        spin(3) { false }
+        session.requestResize(mode: 4, widthPoints: 1280, heightPoints: 800, scale: 2)
+        spin(3) { false }
+        print("proof: after modes 1 and 4: grid \(session.configuredGrid().map { "\($0.width)x\($0.height)" } ?? "-"); second bounds \(CGDisplayBounds(second.displayID)); main bounds \(CGDisplayBounds(main.displayID))")
+        XCTAssertEqual(Int(CGDisplayBounds(main.displayID).width), Int(main.width), "main display mode unchanged")
+        XCTAssertEqual(Int(CGDisplayBounds(second.displayID).width), Int(second.width), "second display mode unchanged")
+
+        // 6. Back to main.
+        session.selectDisplay(main.displayID)
+        spin(10) { results.count >= 2 }
+        let back = try XCTUnwrap(results.dropFirst().first)
+        print("proof: choose \(main.displayID): answer \(back.status) shown \(back.displayID), picture \(back.pictureWidth)x\(back.pictureHeight), pointer \(back.pointerX),\(back.pointerY); pointer now \(pointer())")
+        XCTAssertEqual(back.status, .ok); XCTAssertEqual(back.displayID, main.displayID)
+        spin(10) { session.configuredGrid()?.width == Int(back.pictureWidth) && session.configuredGrid()?.height == Int(back.pictureHeight) }
+        spin(4) { false }
+        let pic1 = try XCTUnwrap(picture(session))
+        let m1 = try screenshot(display: 1, name: "back-main-screenshot.png")
+        let m2 = try screenshot(display: 2, name: "back-second-screenshot.png")
+        save(pic1, "back-main-viewer-picture.png")
+        let e1 = difference(pic1, m1), e2 = difference(pic1, m2)
+        print(String(format: "proof: back on main: picture %dx%d differs from main's screenshot by %.1f, from second's by %.1f",
+                     pic1.width, pic1.height, e1, e2))
+        XCTAssertLessThan(e1, e2, "the picture is main's again")
+        session.stop()
+        spin(1) { false }
+    }
+}
