+				  modulus.isOdd,
+				  let base = BigNum(data: generator),
+				  let peer = BigNum(data: peerKey) else {
+				return false
+			}
+
+			return base.isValidDiffieHellmanPublicValue(modulus: modulus) &&
+				peer.isValidDiffieHellmanPublicValue(modulus: modulus)
+		}
 	}
 }
 
