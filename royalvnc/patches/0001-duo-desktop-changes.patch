diff --git a/duo-screens/royalvnc/Sources/RoyalVNCKit/Encryption/BigNum.swift b/duo-screens/royalvnc/Sources/RoyalVNCKit/Encryption/BigNum.swift
index a59edd8ea..d3ee677c2 100644
--- a/duo-screens/royalvnc/Sources/RoyalVNCKit/Encryption/BigNum.swift
+++ b/duo-screens/royalvnc/Sources/RoyalVNCKit/Encryption/BigNum.swift
@@ -102,6 +102,15 @@ extension BigNum {
     func isLessThan(_ value: UInt64) -> Bool {
         bigInt < value
     }
+
+    // Duo Desktop (#43): checks on server-supplied Diffie-Hellman values.
+    var isOdd: Bool { bigInt & 1 == 1 }
+
+    /// 1 < self < modulus - 1, with a modulus of at least 5.
+    func isValidDiffieHellmanPublicValue(modulus: BigNum) -> Bool {
+        guard modulus.bigInt >= 5 else { return false }
+        return bigInt > 1 && bigInt < modulus.bigInt - 1
+    }
 }
 
 
